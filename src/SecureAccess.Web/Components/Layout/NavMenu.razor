@using SecureAccess.Application.Common

<div class="sa-sidebar-brand">
    <div class="sa-brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
    </div>
    <span class="sa-brand-text">Secure Access</span>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column sa-nav">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-icon" aria-hidden="true">@IconGrid</span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="request-access">
                        <span class="nav-icon" aria-hidden="true">@IconKey</span> Request Credentials
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="clients">
                        <span class="nav-icon" aria-hidden="true">@IconUsers</span> Clients
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="machines">
                        <span class="nav-icon" aria-hidden="true">@IconServer</span> Machines
                    </NavLink>
                </div>

                <AuthorizeView Policy="perm:credentials.create" Context="c">
                    <div class="nav-item"><NavLink class="nav-link" href="credentials"><span class="nav-icon" aria-hidden="true">@IconLock</span> Credentials</NavLink></div>
                    <div class="nav-item"><NavLink class="nav-link" href="credential-types"><span class="nav-icon" aria-hidden="true">@IconTag</span> Credential Types</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:templates.manage" Context="t">
                    <div class="nav-item"><NavLink class="nav-link" href="templates"><span class="nav-icon" aria-hidden="true">@IconCopy</span> Templates</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:bulk.operations" Context="b">
                    <div class="nav-item"><NavLink class="nav-link" href="bulk"><span class="nav-icon" aria-hidden="true">@IconLayers</span> Bulk Operations</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:reports.view" Context="r">
                    <div class="nav-item"><NavLink class="nav-link" href="reports"><span class="nav-icon" aria-hidden="true">@IconChart</span> Reports</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:audit.view" Context="a">
                    <div class="nav-item"><NavLink class="nav-link" href="audit"><span class="nav-icon" aria-hidden="true">@IconList</span> Audit Logs</NavLink></div>
                    <div class="nav-item"><NavLink class="nav-link" href="sessions"><span class="nav-icon" aria-hidden="true">@IconClock</span> Sessions</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:data.export" Context="d">
                    <div class="nav-item"><NavLink class="nav-link" href="import-export"><span class="nav-icon" aria-hidden="true">@IconUpload</span> Import / Export</NavLink></div>
                </AuthorizeView>

                <AuthorizeView Policy="perm:users.manage" Context="u">
                    <div class="nav-item"><NavLink class="nav-link" href="users"><span class="nav-icon" aria-hidden="true">@IconUser</span> Users</NavLink></div>
                </AuthorizeView>
                <AuthorizeView Policy="perm:roles.manage" Context="rl">
                    <div class="nav-item"><NavLink class="nav-link" href="roles"><span class="nav-icon" aria-hidden="true">@IconShield</span> Roles</NavLink></div>
                </AuthorizeView>

                <!-- <div class="nav-item nav-item-bottom">
                    <NavLink class="nav-link nav-link-highlight" href="change-password">
                        <span class="nav-icon" aria-hidden="true">@IconLock</span> Change Password
                    </NavLink>
                </div> -->
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static MarkupString IconGrid => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>");
    private static MarkupString IconKey => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4\"/></svg>");
    private static MarkupString IconUsers => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>");
    private static MarkupString IconServer => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\"/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\"/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"/></svg>");
    private static MarkupString IconLock => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>");
    private static MarkupString IconTag => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"/><line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"/></svg>");
    private static MarkupString IconCopy => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>");
    private static MarkupString IconLayers => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg>");
    private static MarkupString IconChart => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg>");
    private static MarkupString IconList => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><line x1=\"3\" y1=\"6\" x2=\"3.01\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"3.01\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"3.01\" y2=\"18\"/></svg>");
    private static MarkupString IconClock => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>");
    private static MarkupString IconUpload => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg>");
    private static MarkupString IconUser => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>");
    private static MarkupString IconShield => new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>");
}
