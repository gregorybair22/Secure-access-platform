@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row d-flex justify-content-between align-items-center">
            <div class="top-row-search">
                <svg class="top-row-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <form action="/search" method="get" role="search">
                    <input type="search" name="q" placeholder="Search anything..." autocomplete="off" />
                </form>
            </div>
            <AuthorizeView>
                <Authorized>
                    <details class="user-menu">
                        <summary class="top-row-user-pill" aria-haspopup="menu">
                            <span class="top-row-user-avatar" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            </span>
                            <span class="user-menu-name">@(context.User.Identity?.Name ?? "User")</span>
                            <svg class="user-menu-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </summary>
                        <div class="user-menu-dropdown" role="menu">
                            <a class="user-menu-item" href="/change-password" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                                </svg>
                                Change password
                            </a>
                            <form action="/account/logout" method="post" class="user-menu-logout-form">
                                <button type="submit" class="user-menu-item user-menu-item-danger" role="menuitem">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                                    </svg>
                                    Log out
                                </button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content">
            @Body
        </article>

        <footer class="app-footer">
            © @DateTime.UtcNow.Year Secure Access. All rights reserved.
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<script>
    document.addEventListener('click', function (e) {
        document.querySelectorAll('.user-menu[open]').forEach(function (menu) {
            if (!menu.contains(e.target)) menu.removeAttribute('open');
        });
    });
</script>
