@page "/templates"
@attribute [Authorize(Policy = "perm:templates.manage")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Templates.ITemplateService TemplateSvc
@inject SecureAccess.Application.Features.Credentials.ICredentialTypeService TypeSvc
@inject SecureAccess.Application.Features.Machines.IMachineService MachineSvc

<PageTitle>Templates - Secure Access</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Credential Templates</h1>
    <button class="btn btn-primary" @onclick="StartNew">New Template</button>
</div>

@if (!string.IsNullOrEmpty(_message)) { <div class="alert alert-info py-2">@_message</div> }
@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }

@if (_editing is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editingId == 0 ? "New Template" : "Edit Template")</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-4"><label class="form-label">Name *</label><input class="form-control" @bind="_editing.Name" /></div>
                <div class="col-md-4"><label class="form-label">Type *</label>
                    <select class="form-select" @bind="_editing.CredentialTypeId" @bind:after="OnTypeChanged" disabled="@(_editingId != 0)">
                        <option value="0">-- select --</option>
                        @foreach (var t in _types) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">Description</label><input class="form-control" @bind="_editing.Description" /></div>
            </div>
            @if (_selectedType is not null)
            {
                <div class="row g-2">
                    @foreach (var f in _selectedType.Fields)
                    {
                        <div class="col-md-6">
                            <label class="form-label">@f.Label</label>
                            <input class="form-control" @bind="_values[f.Key]" />
                        </div>
                    }
                </div>
            }
            <div class="mt-3">
                <button class="btn btn-success" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_applying is not null)
{
    <div class="card mb-3 border-primary">
        <div class="card-header">Apply Template: @_applying.Name</div>
        <div class="card-body">
            <label class="form-label">Target Machines</label>
            <select class="form-select mb-2" multiple size="6" @onchange="OnMachineSelect">
                @foreach (var m in _machines) { <option value="@m.Id">@m.ClientName / @m.Name</option> }
            </select>
            <div class="form-check"><input class="form-check-input" type="checkbox" @bind="_fillEmpty" id="fe" /><label class="form-check-label" for="fe">Fill empty fields only</label></div>
            <div class="form-check"><input class="form-check-input" type="checkbox" @bind="_overwrite" id="ow" /><label class="form-check-label" for="ow">Overwrite existing values</label></div>
            <div class="mt-2">
                <button class="btn btn-primary" @onclick="ApplyConfirmed">Apply to @_selectedMachineIds.Count machine(s)</button>
                <button class="btn btn-secondary" @onclick="() => _applying = null">Cancel</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Type</th><th>Description</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in _items)
        {
            <tr>
                <td>@t.Name</td><td>@t.CredentialTypeName</td><td>@t.Description</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-success" @onclick="() => StartApply(t)">Apply</button>
                    <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => Edit(t)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(t.Id)">Delete</button>
                </td>
            </tr>
        }
        @if (_items.Count == 0) { <tr><td colspan="4" class="text-muted">No templates.</td></tr> }
    </tbody>
</table>

@code {
    private List<SecureAccess.Application.Features.Templates.TemplateDto> _items = new();
    private List<SecureAccess.Application.Features.Credentials.CredentialTypeDto> _types = new();
    private List<SecureAccess.Application.Features.Machines.MachineDto> _machines = new();

    private SecureAccess.Application.Features.Templates.SaveTemplateRequest? _editing;
    private int _editingId;
    private SecureAccess.Application.Features.Credentials.CredentialTypeDto? _selectedType;
    private Dictionary<string, string?> _values = new();

    private SecureAccess.Application.Features.Templates.TemplateDto? _applying;
    private readonly List<int> _selectedMachineIds = new();
    private bool _fillEmpty, _overwrite;
    private string? _message, _error;

    protected override async Task OnInitializedAsync()
    {
        _types = (await TypeSvc.GetTypesAsync()).ToList();
        _machines = (await MachineSvc.GetMachinesAsync(null, null, 1, 500)).Items.ToList();
        await Reload();
    }

    private async Task Reload() => _items = (await TemplateSvc.GetTemplatesAsync()).ToList();

    private void StartNew() { _editingId = 0; _editing = new(); _selectedType = null; _values = new(); }

    private void OnTypeChanged()
    {
        _selectedType = _types.FirstOrDefault(t => t.Id == _editing!.CredentialTypeId);
        _values = new();
        if (_selectedType is not null) foreach (var f in _selectedType.Fields) _values[f.Key] = null;
    }

    private void Edit(SecureAccess.Application.Features.Templates.TemplateDto t)
    {
        _editingId = t.Id;
        _editing = new() { CredentialTypeId = t.CredentialTypeId, Name = t.Name, Description = t.Description, IsActive = t.IsActive };
        _selectedType = _types.FirstOrDefault(x => x.Id == t.CredentialTypeId);
        _values = new();
        if (_selectedType is not null)
            foreach (var f in _selectedType.Fields) _values[f.Key] = t.PlainValues.TryGetValue(f.Key, out var v) ? v : null;
    }

    private async Task Save()
    {
        _editing!.Values = _values;
        var result = _editingId == 0 ? (Result)await TemplateSvc.CreateAsync(_editing) : await TemplateSvc.UpdateAsync(_editingId, _editing);
        if (!result.Succeeded) { _error = result.Error; return; }
        _editing = null; _error = null;
        await Reload();
    }

    private async Task Delete(int id) { await TemplateSvc.DeleteAsync(id); await Reload(); }

    private void StartApply(SecureAccess.Application.Features.Templates.TemplateDto t)
    {
        _applying = t; _selectedMachineIds.Clear(); _fillEmpty = false; _overwrite = false; _message = null;
    }

    private void OnMachineSelect(ChangeEventArgs e)
    {
        _selectedMachineIds.Clear();
        if (e.Value is string[] vals)
            foreach (var v in vals) if (int.TryParse(v, out var id)) _selectedMachineIds.Add(id);
    }

    private async Task ApplyConfirmed()
    {
        var result = await TemplateSvc.ApplyToMachinesAsync(new()
        {
            TemplateId = _applying!.Id,
            MachineIds = _selectedMachineIds,
            FillEmptyOnly = _fillEmpty,
            Overwrite = _overwrite
        });
        if (!result.Succeeded) { _error = result.Error; return; }
        _message = $"Template applied to {result.Value} machine(s).";
        _applying = null;
    }
}
