@page "/request-access"
@attribute [Authorize(Policy = "perm:credentials.request")]
@rendermode InteractiveServer
@using SecureAccess.Domain.Enums

<PageTitle>Request Credentials - Secure Access</PageTitle>

<div class="reqaccess-page">
    <header class="reqaccess-page-header">
        <div class="reqaccess-page-title-block">
            <div class="reqaccess-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
            </div>
            <div>
                <h1>Request Credentials</h1>
                <p class="reqaccess-page-subtitle">Credentials are only revealed after a reason and internal ticket are recorded.</p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="reqaccess-page-alert" role="alert">@_error</div>
    }

    <article class="reqaccess-card">
        <div class="reqaccess-card-head">
            <div class="reqaccess-card-head-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
            </div>
            <h2>Request Details</h2>
        </div>

        <div class="reqaccess-card-body">
            <div class="reqaccess-form-row reqaccess-form-row-3">
                <div class="reqaccess-field">
                    <label for="reqaccess-client">Client</label>
                    <div class="reqaccess-select-wrap">
                        <span class="reqaccess-field-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                            </svg>
                        </span>
                        <select id="reqaccess-client" class="reqaccess-select" @bind="_clientId" @bind:after="OnClientChangedAsync">
                            <option value="0">Select client</option>
                            @foreach (var c in _clients)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="reqaccess-field">
                    <label for="reqaccess-machine">Machine <span class="reqaccess-required" aria-hidden="true">*</span></label>
                    <div class="reqaccess-select-wrap">
                        <span class="reqaccess-field-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </span>
                        <select id="reqaccess-machine" class="reqaccess-select" @bind="_request.MachineId">
                            <option value="0">Select machine</option>
                            @foreach (var m in _machines)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="reqaccess-field">
                    <label for="reqaccess-reason-cat">Reason Category</label>
                    <div class="reqaccess-select-wrap">
                        <span class="reqaccess-field-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                        </span>
                        <select id="reqaccess-reason-cat" class="reqaccess-select" @bind="_request.ReasonCategory">
                            @foreach (var r in Enum.GetValues<AccessReasonCategory>())
                            {
                                <option value="@r">@FormatReasonCategory(r)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="reqaccess-field">
                <label for="reqaccess-reason">Reason <span class="reqaccess-required" aria-hidden="true">*</span></label>
                <input id="reqaccess-reason" class="reqaccess-input" @bind="_request.Reason" placeholder="e.g. Software update" />
                <p class="reqaccess-hint">Briefly describe why you need access to these credentials.</p>
            </div>

            <div class="reqaccess-form-row reqaccess-form-row-2">
                <div class="reqaccess-field">
                    <label for="reqaccess-ticket">Internal Ticket <span class="reqaccess-required" aria-hidden="true">*</span></label>
                    <input id="reqaccess-ticket" class="reqaccess-input" @bind="_request.InternalTicket" placeholder="e.g. SAT-2026-00482" />
                    <p class="reqaccess-hint">Your internal service or change ticket reference.</p>
                </div>
                <div class="reqaccess-field">
                    <label for="reqaccess-customer-ref">Customer Reference (optional)</label>
                    <input id="reqaccess-customer-ref" class="reqaccess-input" @bind="_request.CustomerTicket" placeholder="e.g. INC-ALZIRA-2045" />
                    <p class="reqaccess-hint">Customer-facing reference, if applicable.</p>
                </div>
            </div>

            <div class="reqaccess-actions">
                <button type="button" class="reqaccess-btn-primary" disabled="@_busy" @onclick="SubmitAsync">
                    @if (_busy)
                    {
                        <span class="reqaccess-btn-spinner" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    }
                    Reveal Credentials
                </button>
                <button type="button" class="reqaccess-btn-secondary" disabled="@_busy" @onclick="ClearForm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                    Clear Form
                </button>
            </div>

            @if (_showNote)
            {
                <div class="reqaccess-note" role="note">
                    <div class="reqaccess-note-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="16" x2="12" y2="12"/>
                            <line x1="12" y1="8" x2="12.01" y2="8"/>
                        </svg>
                    </div>
                    <div class="reqaccess-note-content">
                        <p class="reqaccess-note-title">Important Note</p>
                        <p>All credential access is logged and audited. Secrets are only shown after your request is recorded with a valid reason and ticket.</p>
                    </div>
                    <button type="button" class="reqaccess-note-close" aria-label="Dismiss note" @onclick="() => _showNote = false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </article>

    @if (_result is not null)
    {
        <section class="reqaccess-results">
            <header class="reqaccess-results-header">
                <h2>Revealed Credentials</h2>
                <p>@_result.ClientName · @_result.MachineName</p>
            </header>

            @if (_result.Credentials.Count == 0)
            {
                <div class="reqaccess-results-empty">No credentials are available for this machine.</div>
            }
            else
            {
                @foreach (var cred in _result.Credentials)
                {
                    <article class="reqaccess-cred-card">
                        <div class="reqaccess-cred-head">
                            <div>
                                <h3>@cred.Label</h3>
                                <span class="reqaccess-cred-type">@cred.CredentialTypeName</span>
                            </div>
                            <span class="reqaccess-cred-scope">@cred.Scope</span>
                        </div>
                        <table class="reqaccess-cred-table">
                            <tbody>
                                @foreach (var f in cred.Fields)
                                {
                                    <tr>
                                        <th>@f.Label</th>
                                        <td>
                                            @if (f.IsSecret)
                                            {
                                                <code class="reqaccess-secret">@(IsShown(cred.Id, f.Key) ? f.Value : "••••••••")</code>
                                                <button type="button" class="reqaccess-toggle-secret" @onclick="() => ToggleSecret(cred.Id, f.Key)">
                                                    @(IsShown(cred.Id, f.Key) ? "Hide" : "Show")
                                                </button>
                                            }
                                            else
                                            {
                                                <span>@f.Value</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (!string.IsNullOrEmpty(cred.Notes))
                        {
                            <p class="reqaccess-cred-notes">@cred.Notes</p>
                        }
                    </article>
                }
            }
        </section>
    }
</div>
