@page "/sessions"
@attribute [Authorize(Policy = "perm:audit.view")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Audit.IAuditQueryService Audit

<PageTitle>Sessions - Secure Access</PageTitle>

<h1>Session Tracking</h1>

<table class="table table-sm table-striped">
    <thead><tr><th>User</th><th>Login</th><th>Logout</th><th>Duration</th><th>IP</th><th>Machines</th><th>Customers</th><th>Credentials</th><th>Active</th></tr></thead>
    <tbody>
        @foreach (var s in _page.Items)
        {
            <tr>
                <td>@s.UserName</td>
                <td>@s.LoginUtc.ToLocalTime().ToString("g")</td>
                <td>@(s.LogoutUtc?.ToLocalTime().ToString("g") ?? "-")</td>
                <td>@(s.Duration ?? "-")</td>
                <td>@s.IpAddress</td>
                <td>@s.MachinesAccessed</td>
                <td>@s.CustomersAccessed</td>
                <td>@s.CredentialsViewed</td>
                <td>@(s.IsActive ? "Yes" : "No")</td>
            </tr>
        }
        @if (_page.Items.Count == 0) { <tr><td colspan="9" class="text-muted">No sessions.</td></tr> }
    </tbody>
</table>

@code {
    private PagedResult<SecureAccess.Application.Features.Audit.SessionDto> _page = new();
    protected override async Task OnInitializedAsync() => _page = await Audit.GetSessionsAsync(1, 100);
}
