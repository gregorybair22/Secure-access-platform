@page "/sessions"
@attribute [Authorize(Policy = "perm:audit.view")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Audit
@inject IAuditQueryService Audit

<PageTitle>Session Tracking - Secure Access</PageTitle>

<div class="sessions-page">
    <header class="sessions-page-header">
        <div class="sessions-page-title-block">
            <div class="sessions-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
            </div>
            <div>
                <h1>Session Tracking</h1>
                <p class="sessions-page-subtitle">Monitor user sessions and activity in real-time.</p>
            </div>
        </div>
    </header>

    <div class="sessions-card">
        <div class="sessions-toolbar">
            <div class="sessions-toolbar-search">
                <svg class="sessions-toolbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="search" placeholder="Search by user or IP address..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="sessions-date-range">
                <input type="date" class="sessions-date-input" @bind="_startDate" @bind:after="ResetPage" aria-label="Start date" />
                <span class="sessions-date-arrow" aria-hidden="true">→</span>
                <input type="date" class="sessions-date-input" @bind="_endDate" @bind:after="ResetPage" aria-label="End date" />
            </div>
            <select @bind="_userFilter" @bind:after="ResetPage">
                <option value="">All Users</option>
                @foreach (var name in _userNames)
                {
                    <option value="@name">@name</option>
                }
            </select>
            <select @bind="_activeFilter" @bind:after="ResetPage">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <button type="button" class="sessions-btn-outline" title="Filters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Filters
            </button>
        </div>

        <div class="sessions-table-wrap">
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("user")" @onclick='() => SortBy("user")'>User @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("login")" @onclick='() => SortBy("login")'>Login @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("logout")" @onclick='() => SortBy("logout")'>Logout @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("duration")" @onclick='() => SortBy("duration")'>Duration @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("ip")" @onclick='() => SortBy("ip")'>IP Address @SortIcon</button></th>
                        <th class="text-center sessions-th-num"><button type="button" class="sessions-th-sort @SortClass("machines")" @onclick='() => SortBy("machines")'>Machines @SortIcon</button></th>
                        <th class="text-center sessions-th-num"><button type="button" class="sessions-th-sort @SortClass("customers")" @onclick='() => SortBy("customers")'>Customers @SortIcon</button></th>
                        <th class="text-center sessions-th-num"><button type="button" class="sessions-th-sort @SortClass("credentials")" @onclick='() => SortBy("credentials")'>Credentials @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="sessions-th-sort @SortClass("active")" @onclick='() => SortBy("active")'>Active @SortIcon</button></th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedItems.Count == 0)
                    {
                        <tr><td colspan="9" class="sessions-empty">No sessions found.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in PagedItems)
                        {
                            <tr>
                                <td>
                                    <div class="sessions-user-cell">
                                        <span class="sessions-avatar" aria-hidden="true">@AvatarInitial(s.UserName)</span>
                                        <span class="sessions-username">@s.UserName</span>
                                    </div>
                                </td>
                                <td class="text-center">@FormatDateTime(s.LoginUtc)</td>
                                <td class="text-center">@(s.LogoutUtc.HasValue ? FormatDateTime(s.LogoutUtc.Value) : "—")</td>
                                <td class="text-center">@FormatDuration(s)</td>
                                <td class="text-center">@(string.IsNullOrWhiteSpace(s.IpAddress) ? "—" : s.IpAddress)</td>
                                <td class="text-center sessions-td-num">@s.MachinesAccessed</td>
                                <td class="text-center sessions-td-num">@s.CustomersAccessed</td>
                                <td class="text-center sessions-td-num">@s.CredentialsViewed</td>
                                <td class="text-center">
                                    <span class="sessions-active-badge @(s.IsActive ? "sessions-active-yes" : "sessions-active-no")">
                                        @(s.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="sessions-footer">
            <span>Showing @RangeStart to @RangeEnd of @FilteredCount sessions</span>
            <div class="sessions-pagination">
                <button type="button" disabled="@(_page <= 1)" @onclick="PrevPage" aria-label="Previous page">‹</button>
                @for (var p = 1; p <= TotalPages; p++)
                {
                    var pageNum = p;
                    <button type="button" class="@(_page == pageNum ? "active" : null)" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                }
                <button type="button" disabled="@(_page >= TotalPages)" @onclick="NextPage" aria-label="Next page">›</button>
            </div>
        </footer>
    </div>
</div>

@code {
    private const int PageSize = 10;

    private List<SessionDto> _items = new();
    private List<string> _userNames = new();

    private string _search = "";
    private string _userFilter = "";
    private string _activeFilter = "";
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _sortColumn = "login";
    private bool _sortAsc = false;
    private int _page = 1;

    private MarkupString SortIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">" +
        "<path d=\"m7 15 5 5 5-5\"/><path d=\"m7 9 5-4 5 4\"/></svg>");

    private IEnumerable<SessionDto> FilteredItems
    {
        get
        {
            IEnumerable<SessionDto> q = _items;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                q = q.Where(s =>
                    s.UserName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (s.IpAddress?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrEmpty(_userFilter))
                q = q.Where(s => s.UserName == _userFilter);

            if (_activeFilter == "active")
                q = q.Where(s => s.IsActive);
            else if (_activeFilter == "inactive")
                q = q.Where(s => !s.IsActive);

            if (_startDate.HasValue)
            {
                var from = DateTime.SpecifyKind(_startDate.Value.Date, DateTimeKind.Local).ToUniversalTime();
                q = q.Where(s => s.LoginUtc >= from);
            }

            if (_endDate.HasValue)
            {
                var to = DateTime.SpecifyKind(_endDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime();
                q = q.Where(s => s.LoginUtc <= to);
            }

            q = _sortColumn switch
            {
                "user" => _sortAsc ? q.OrderBy(s => s.UserName) : q.OrderByDescending(s => s.UserName),
                "logout" => _sortAsc ? q.OrderBy(s => s.LogoutUtc) : q.OrderByDescending(s => s.LogoutUtc),
                "duration" => _sortAsc ? q.OrderBy(DurationSeconds) : q.OrderByDescending(DurationSeconds),
                "ip" => _sortAsc ? q.OrderBy(s => s.IpAddress) : q.OrderByDescending(s => s.IpAddress),
                "machines" => _sortAsc ? q.OrderBy(s => s.MachinesAccessed) : q.OrderByDescending(s => s.MachinesAccessed),
                "customers" => _sortAsc ? q.OrderBy(s => s.CustomersAccessed) : q.OrderByDescending(s => s.CustomersAccessed),
                "credentials" => _sortAsc ? q.OrderBy(s => s.CredentialsViewed) : q.OrderByDescending(s => s.CredentialsViewed),
                "active" => _sortAsc ? q.OrderBy(s => s.IsActive) : q.OrderByDescending(s => s.IsActive),
                _ => _sortAsc ? q.OrderBy(s => s.LoginUtc) : q.OrderByDescending(s => s.LoginUtc)
            };

            return q;
        }
    }

    private int FilteredCount => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
    private List<SessionDto> PagedItems =>
        FilteredItems.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private int RangeStart => FilteredCount == 0 ? 0 : (_page - 1) * PageSize + 1;
    private int RangeEnd => Math.Min(_page * PageSize, FilteredCount);

    protected override async Task OnInitializedAsync()
    {
        var page = await Audit.GetSessionsAsync(1, 500);
        _items = page.Items.ToList();
        _userNames = _items.Select(s => s.UserName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n).ToList();
    }

    private static double DurationSeconds(SessionDto s)
    {
        if (s.LogoutUtc.HasValue)
            return (s.LogoutUtc.Value - s.LoginUtc).TotalSeconds;
        return (DateTime.UtcNow - s.LoginUtc).TotalSeconds;
    }

    private static string FormatDateTime(DateTime utc) =>
        utc.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private static string FormatDuration(SessionDto s)
    {
        TimeSpan span;
        if (s.LogoutUtc.HasValue)
            span = s.LogoutUtc.Value - s.LoginUtc;
        else
            span = DateTime.UtcNow - s.LoginUtc;

        return span.ToString(@"hh\:mm\:ss");
    }

    private static string AvatarInitial(string userName) =>
        string.IsNullOrEmpty(userName) ? "?" : char.ToUpperInvariant(userName[0]).ToString();

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = column is "user" or "ip";
        }
        _page = 1;
    }

    private string SortClass(string column) => _sortColumn == column ? "active" : "";

    private void ResetPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void GoToPage(int p) => _page = p;
}
