@page "/machines"
@attribute [Authorize(Policy = "perm:machines.view")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Machines.IMachineService MachineSvc
@inject SecureAccess.Application.Features.Clients.IClientService ClientSvc
@inject ICurrentUserService Current

<PageTitle>Machines - Secure Access</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Machines</h1>
    @if (Current.HasPermission(Permissions.MachinesCreate))
    {
        <button class="btn btn-primary" @onclick="() => Edit(new())">New Machine</button>
    }
</div>

<div class="input-group mb-3" style="max-width:400px">
    <input class="form-control" placeholder="Search name, serial, model..." @bind="_search" @bind:event="oninput" @onkeyup="Reload" />
</div>

@if (_editing is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editing.Id == 0 ? "New Machine" : $"Edit: {_editing.Name}")</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">Client *</label>
                    <select class="form-select" @bind="_form.ClientId">
                        <option value="0">-- select --</option>
                        @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="col-md-6"><label class="form-label">Name *</label><input class="form-control" @bind="_form.Name" /></div>
                <div class="col-md-6"><label class="form-label">Serial Number</label><input class="form-control" @bind="_form.SerialNumber" /></div>
                <div class="col-md-6"><label class="form-label">Model</label><input class="form-control" @bind="_form.Model" /></div>
                <div class="col-md-6"><label class="form-label">Location</label><input class="form-control" @bind="_form.Location" /></div>
                <div class="col-md-6"><label class="form-label">Status</label>
                    <select class="form-select" @bind="_form.Status">
                        @foreach (var s in Enum.GetValues<EntityStatus>()) { <option value="@s">@s</option> }
                    </select>
                </div>
                <div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" @bind="_form.Notes"></textarea></div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped table-hover">
    <thead><tr><th>Client</th><th>Machine</th><th>Serial</th><th>Model</th><th>Credentials</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var m in _items)
        {
            <tr>
                <td>@m.ClientName</td>
                <td>@m.Name</td>
                <td>@m.SerialNumber</td>
                <td>@m.Model</td>
                <td><a href="/credentials?machineId=@m.Id">@m.CredentialCount</a></td>
                <td>@m.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-success" href="/request-access?machineId=@m.Id">Request</a>
                    @if (Current.HasPermission(Permissions.MachinesEdit))
                    { <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => Edit(m)">Edit</button> }
                    @if (Current.HasPermission(Permissions.MachinesDelete))
                    { <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(m.Id)">Delete</button> }
                </td>
            </tr>
        }
        @if (_items.Count == 0) { <tr><td colspan="7" class="text-muted">No machines found.</td></tr> }
    </tbody>
</table>

@code {
    [SupplyParameterFromQuery] public int? ClientId { get; set; }

    private List<SecureAccess.Application.Features.Machines.MachineDto> _items = new();
    private List<SecureAccess.Application.Features.Clients.ClientDto> _clients = new();
    private string? _search;
    private SecureAccess.Application.Features.Machines.MachineDto? _editing;
    private SecureAccess.Application.Features.Machines.SaveMachineRequest _form = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _clients = (await ClientSvc.GetClientsAsync(null, 1, 500)).Items.ToList();
        await Reload();
    }

    private async Task Reload()
    {
        var page = await MachineSvc.GetMachinesAsync(ClientId, _search, 1, 100);
        _items = page.Items.ToList();
    }

    private void Edit(SecureAccess.Application.Features.Machines.MachineDto m)
    {
        _error = null;
        _editing = m;
        _form = new()
        {
            ClientId = m.ClientId == 0 ? (ClientId ?? 0) : m.ClientId,
            Name = m.Name, SerialNumber = m.SerialNumber, Model = m.Model,
            Location = m.Location, Status = m.Status == 0 ? EntityStatus.Active : m.Status, Notes = m.Notes
        };
    }

    private async Task Save()
    {
        if (_form.ClientId == 0) { _error = "Please select a client."; return; }
        var result = _editing!.Id == 0 ? (Result)await MachineSvc.CreateAsync(_form) : await MachineSvc.UpdateAsync(_editing.Id, _form);
        if (!result.Succeeded) { _error = result.Error; return; }
        _editing = null;
        await Reload();
    }

    private async Task Delete(int id)
    {
        await MachineSvc.DeleteAsync(id);
        await Reload();
    }
}
