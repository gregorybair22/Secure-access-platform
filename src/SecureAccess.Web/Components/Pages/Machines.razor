@page "/machines"
@attribute [Authorize(Policy = "perm:machines.view")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Machines
@using SecureAccess.Application.Features.Clients
@using SecureAccess.Application.Common
@inject IMachineService MachineSvc
@inject IClientService ClientSvc
@inject ICurrentUserService Current

<PageTitle>Machines - Secure Access</PageTitle>

<div class="machines-page">
    <header class="machines-page-header">
        <div class="machines-page-title-block">
            <div class="machines-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2"/>
                    <rect x="2" y="14" width="20" height="8" rx="2"/>
                    <line x1="6" y1="6" x2="6.01" y2="6"/>
                    <line x1="6" y1="18" x2="6.01" y2="18"/>
                </svg>
            </div>
            <div>
                <h1>Machines</h1>
                <p class="machines-page-subtitle">View and manage all registered machines across clients.</p>
            </div>
        </div>
        @if (Current.HasPermission(Permissions.MachinesCreate))
        {
            <button type="button" class="machines-btn-primary" @onclick="StartNew">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Machine
            </button>
        }
    </header>

    <div class="machines-stats">
        <article class="machines-stat-card">
            <div class="machines-stat-icon machines-stat-icon-total" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2"/>
                    <rect x="2" y="14" width="20" height="8" rx="2"/>
                    <line x1="6" y1="6" x2="6.01" y2="6"/>
                    <line x1="6" y1="18" x2="6.01" y2="18"/>
                </svg>
            </div>
            <div>
                <p class="machines-stat-label">Total Machines</p>
                <p class="machines-stat-value">@_stats.TotalMachines</p>
                <p class="machines-stat-hint">Across all clients</p>
            </div>
        </article>
        <article class="machines-stat-card">
            <div class="machines-stat-icon machines-stat-icon-online" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div>
                <p class="machines-stat-label">Online Machines</p>
                <p class="machines-stat-value">@_stats.OnlineMachines</p>
                <p class="machines-stat-hint">Currently online</p>
            </div>
        </article>
        <article class="machines-stat-card">
            <div class="machines-stat-icon machines-stat-icon-offline" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
            </div>
            <div>
                <p class="machines-stat-label">Offline Machines</p>
                <p class="machines-stat-value">@_stats.OfflineMachines</p>
                <p class="machines-stat-hint">Currently offline</p>
            </div>
        </article>
        <article class="machines-stat-card">
            <div class="machines-stat-icon machines-stat-icon-credentials" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <p class="machines-stat-label">Machines with Credentials</p>
                <p class="machines-stat-value">@_stats.MachinesWithCredentials</p>
                <p class="machines-stat-hint">Configured</p>
            </div>
        </article>
    </div>

    <div class="machines-card">
        <div class="machines-toolbar">
            <div class="machines-toolbar-search">
                <svg class="machines-toolbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="search" placeholder="Search by name, serial, model..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <select @bind="_clientFilter" @bind:after="OnClientFilterChanged" aria-label="Filter by client">
                <option value="0">All Clients</option>
                @foreach (var c in _clients)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <select @bind="_statusFilter" @bind:after="ResetPage" aria-label="Filter by status">
                <option value="">All Status</option>
                @foreach (var s in Enum.GetValues<EntityStatus>())
                {
                    <option value="@s">@StatusLabel(s)</option>
                }
            </select>
            <button type="button" class="machines-btn-outline" title="Filters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Filter
            </button>
        </div>

        @if (PagedItems.Count == 0)
        {
            <div class="machines-empty-state">
                <div class="machines-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="2" width="20" height="8" rx="2"/>
                        <rect x="2" y="14" width="20" height="8" rx="2"/>
                        <line x1="6" y1="6" x2="6.01" y2="6"/>
                        <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                </div>
                <h2>No machines found</h2>
                <p>Get started by adding your first machine.</p>
                @if (Current.HasPermission(Permissions.MachinesCreate))
                {
                    <button type="button" class="machines-btn-primary" @onclick="StartNew">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        New Machine
                    </button>
                }
            </div>
        }
        else
        {
            <div class="machines-table-wrap">
                <table class="machines-table">
                    <thead>
                        <tr>
                            <th class="text-center"><button type="button" class="machines-th-sort @SortClass("client")" @onclick='() => SortBy("client")'>Client @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="machines-th-sort @SortClass("name")" @onclick='() => SortBy("name")'>Machine Name @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="machines-th-sort @SortClass("serial")" @onclick='() => SortBy("serial")'>Serial @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="machines-th-sort @SortClass("model")" @onclick='() => SortBy("model")'>Model @SortIcon</button></th>
                            <th class="text-center machines-th-num"><button type="button" class="machines-th-sort @SortClass("credentials")" @onclick='() => SortBy("credentials")'>Credentials @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="machines-th-sort @SortClass("status")" @onclick='() => SortBy("status")'>Status @SortIcon</button></th>
                            <th class="text-center machines-th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in PagedItems)
                        {
                            <tr>
                                <td class="text-center"><span class="machines-client-name">@m.ClientName</span></td>
                                <td class="text-center"><span class="machines-machine-name">@m.Name</span></td>
                                <td class="text-center">@(string.IsNullOrWhiteSpace(m.SerialNumber) ? "—" : m.SerialNumber)</td>
                                <td class="text-center">@(string.IsNullOrWhiteSpace(m.Model) ? "—" : m.Model)</td>
                                <td class="text-center machines-td-num">
                                    <a href="/credentials?machineId=@m.Id">@m.CredentialCount</a>
                                </td>
                                <td class="text-center"><span class="machines-status-badge @StatusClass(m.Status)">@StatusLabel(m.Status)</span></td>
                                <td class="text-center">
                                    <div class="machines-actions">
                                        <a class="machines-btn-request" href="/request-access?machineId=@m.Id">Request</a>
                                        @if (Current.HasPermission(Permissions.MachinesEdit))
                                        {
                                            <button type="button" class="machines-btn-edit" @onclick="() => Edit(m)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit
                                            </button>
                                        }
                                        @if (Current.HasPermission(Permissions.MachinesDelete))
                                        {
                                            <button type="button" class="machines-btn-delete" @onclick="() => OpenDeleteConfirm(m)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                                </svg>
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="machines-footer">
            <span>Showing @RangeStart to @RangeEnd of @FilteredCount machines</span>
            <div class="machines-footer-right">
                <label class="machines-page-size">
                    Rows per page:
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <div class="machines-pagination">
                    <button type="button" disabled="@(_page <= 1)" @onclick="FirstPage" aria-label="First page">«</button>
                    <button type="button" disabled="@(_page <= 1)" @onclick="PrevPage" aria-label="Previous page">‹</button>
                    @for (var p = 1; p <= TotalPages; p++)
                    {
                        var pageNum = p;
                        <button type="button" class="@(_page == pageNum ? "active" : null)" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="NextPage" aria-label="Next page">›</button>
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="LastPage" aria-label="Last page">»</button>
                </div>
            </div>
        </footer>
    </div>
</div>

@if (_deleteTarget is not null)
{
    <div class="sa-modal-backdrop machines-modal-backdrop @(_deleteModalClosing ? "is-closing" : null)" @onclick="CloseDeleteModalAsync">
        <div class="sa-modal-panel machines-modal machines-modal-confirm" role="alertdialog" aria-modal="true" aria-labelledby="machines-delete-title" @onclick:stopPropagation="true">
            <div class="machines-modal-header machines-modal-header-danger">
                <div class="machines-delete-header-main">
                    <div class="machines-delete-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <div>
                        <h2 id="machines-delete-title">Delete machine</h2>
                        <p class="machines-modal-subtitle">This action cannot be undone.</p>
                    </div>
                </div>
                <button type="button" class="machines-modal-close" aria-label="Close" @onclick="CloseDeleteModalAsync">×</button>
            </div>
            <div class="machines-modal-body">
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="machines-modal-alert" role="alert">@_deleteError</div>
                }
                <p class="machines-delete-message">
                    Are you sure you want to delete <strong>@_deleteTarget.Name</strong>?
                    <span class="machines-delete-detail">(@_deleteTarget.ClientName)</span>
                </p>
            </div>
            <div class="machines-modal-footer">
                <button type="button" class="machines-btn-secondary" @onclick="CloseDeleteModalAsync">Cancel</button>
                <button type="button" class="machines-btn-danger" @onclick="ConfirmDeleteAsync">Delete machine</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="sa-modal-backdrop machines-modal-backdrop @(_editModalClosing ? "is-closing" : null)" @onclick="CloseEditModalAsync">
        <div class="sa-modal-panel machines-modal" role="dialog" aria-modal="true" aria-labelledby="machines-modal-title" @onclick:stopPropagation="true">
            <div class="machines-modal-header">
                <h2 id="machines-modal-title">@(_editingId == 0 ? "New Machine" : "Edit Machine")</h2>
                <button type="button" class="machines-modal-close" aria-label="Close" @onclick="CloseEditModalAsync">×</button>
            </div>
            <div class="machines-modal-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="machines-modal-alert" role="alert">@_error</div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Client *</label>
                        <select class="form-select" @bind="_form.ClientId">
                            <option value="0">-- select --</option>
                            @foreach (var c in _clients)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name *</label>
                        <input class="form-control" @bind="_form.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Serial Number</label>
                        <input class="form-control" @bind="_form.SerialNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Model</label>
                        <input class="form-control" @bind="_form.Model" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Location</label>
                        <input class="form-control" @bind="_form.Location" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="_form.Status">
                            @foreach (var s in Enum.GetValues<EntityStatus>())
                            {
                                <option value="@s">@StatusLabel(s)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="3" @bind="_form.Notes"></textarea>
                    </div>
                </div>
            </div>
            <div class="machines-modal-footer">
                @if (_editingId != 0 && Current.HasPermission(Permissions.MachinesDelete))
                {
                    <button type="button" class="machines-btn-danger machines-modal-delete" @onclick="OpenDeleteFromEditAsync">Delete</button>
                }
                <div class="machines-modal-footer-actions">
                    <button type="button" class="machines-btn-secondary" @onclick="CloseEditModalAsync">Cancel</button>
                    <button type="button" class="machines-btn-primary" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int? ClientId { get; set; }

    private List<MachineDto> _items = new();
    private List<ClientDto> _clients = new();
    private MachineListStats _stats = new();

    private bool? _editing;
    private bool _editModalClosing;
    private bool _deleteModalClosing;
    private int _editingId;
    private SaveMachineRequest _form = new();
    private string? _error;
    private MachineDto? _deleteTarget;
    private string? _deleteError;

    private string _search = "";
    private int _clientFilter;
    private string _statusFilter = "";
    private string _sortColumn = "name";
    private bool _sortAsc = true;
    private int _page = 1;
    private int _pageSize = 10;

    private MarkupString SortIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">" +
        "<path d=\"m7 15 5 5 5-5\"/><path d=\"m7 9 5-4 5 4\"/></svg>");

    private IEnumerable<MachineDto> FilteredItems
    {
        get
        {
            IEnumerable<MachineDto> q = _items;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                q = q.Where(m =>
                    m.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    m.ClientName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (m.SerialNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Model?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrEmpty(_statusFilter) && Enum.TryParse<EntityStatus>(_statusFilter, out var st))
                q = q.Where(m => m.Status == st);

            q = _sortColumn switch
            {
                "client" => _sortAsc ? q.OrderBy(m => m.ClientName) : q.OrderByDescending(m => m.ClientName),
                "serial" => _sortAsc ? q.OrderBy(m => m.SerialNumber) : q.OrderByDescending(m => m.SerialNumber),
                "model" => _sortAsc ? q.OrderBy(m => m.Model) : q.OrderByDescending(m => m.Model),
                "credentials" => _sortAsc ? q.OrderBy(m => m.CredentialCount) : q.OrderByDescending(m => m.CredentialCount),
                "status" => _sortAsc ? q.OrderBy(m => m.Status) : q.OrderByDescending(m => m.Status),
                _ => _sortAsc ? q.OrderBy(m => m.Name) : q.OrderByDescending(m => m.Name)
            };

            return q;
        }
    }

    private int FilteredCount => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));
    private List<MachineDto> PagedItems =>
        FilteredItems.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int RangeStart => FilteredCount == 0 ? 0 : (_page - 1) * _pageSize + 1;
    private int RangeEnd => Math.Min(_page * _pageSize, FilteredCount);

    protected override async Task OnInitializedAsync()
    {
        _clients = (await ClientSvc.GetClientsAsync(null, 1, 500)).Items.ToList();
        if (ClientId.HasValue)
            _clientFilter = ClientId.Value;
        await Reload();
    }

    private int? EffectiveClientId => _clientFilter > 0 ? _clientFilter : null;

    private async Task Reload()
    {
        var page = await MachineSvc.GetMachinesAsync(EffectiveClientId, null, 1, 500);
        _items = page.Items.ToList();
        _stats = await MachineSvc.GetListStatsAsync(EffectiveClientId);
        if (_page > TotalPages) _page = TotalPages;
    }

    private async Task OnClientFilterChanged()
    {
        ResetPage();
        await Reload();
    }

    private void StartNew()
    {
        _editing = true;
        _editingId = 0;
        _error = null;
        _form = new SaveMachineRequest
        {
            ClientId = _clientFilter > 0 ? _clientFilter : (ClientId ?? 0),
            Status = EntityStatus.Active
        };
    }

    private void Edit(MachineDto m)
    {
        _editing = true;
        _editingId = m.Id;
        _error = null;
        _form = new SaveMachineRequest
        {
            ClientId = m.ClientId,
            Name = m.Name,
            SerialNumber = m.SerialNumber,
            Model = m.Model,
            Location = m.Location,
            Status = m.Status == 0 ? EntityStatus.Active : m.Status,
            InstallationDate = m.InstallationDate,
            Notes = m.Notes
        };
    }

    private void OpenDeleteConfirm(MachineDto m)
    {
        _deleteTarget = m;
        _deleteError = null;
    }

    private Task CloseEditModalAsync()
    {
        if (_editing is null || _editModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _editModalClosing,
            v => _editModalClosing = v,
            () => _editing = null,
            StateHasChanged);
    }

    private async Task OpenDeleteFromEditAsync()
    {
        if (_editingId == 0) return;
        var target = _items.FirstOrDefault(m => m.Id == _editingId);
        if (target is null) return;
        await CloseEditModalAsync();
        _deleteTarget = target;
        _deleteError = null;
    }

    private Task CloseDeleteModalAsync()
    {
        if (_deleteTarget is null || _deleteModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _deleteModalClosing,
            v => _deleteModalClosing = v,
            () => _deleteTarget = null,
            StateHasChanged);
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = true;
        }
        _page = 1;
    }

    private string SortClass(string column) => _sortColumn == column ? "active" : "";

    private static string StatusLabel(EntityStatus status) => status switch
    {
        EntityStatus.Active => "Online",
        EntityStatus.Inactive => "Offline",
        _ => status.ToString()
    };

    private static string StatusClass(EntityStatus status) => status switch
    {
        EntityStatus.Active => "machines-status-online",
        EntityStatus.Inactive => "machines-status-offline",
        EntityStatus.Suspended => "machines-status-suspended",
        EntityStatus.Archived => "machines-status-archived",
        _ => "machines-status-offline"
    };

    private void ResetPage() => _page = 1;

    private void OnPageSizeChanged()
    {
        _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void FirstPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void LastPage() => _page = TotalPages;
    private void GoToPage(int p) => _page = p;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;

        _deleteError = null;
        var result = await MachineSvc.DeleteAsync(_deleteTarget.Id);
        if (!result.Succeeded)
        {
            _deleteError = result.Error;
            return;
        }

        if (_editingId == _deleteTarget.Id)
            _editing = null;

        await CloseDeleteModalAsync();
        await Reload();
    }

    private async Task Save()
    {
        if (_form.ClientId == 0)
        {
            _error = "Please select a client.";
            return;
        }

        Result result;
        if (_editingId == 0)
            result = await MachineSvc.CreateAsync(_form);
        else
            result = await MachineSvc.UpdateAsync(_editingId, _form);

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        await CloseEditModalAsync();
        await Reload();
    }
}
