@page "/audit"
@attribute [Authorize(Policy = "perm:audit.view")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Audit
@using SecureAccess.Domain.Enums
@inject IAuditQueryService AuditSvc

<PageTitle>Audit Logs - Secure Access</PageTitle>

<div class="audit-page">
    <header class="audit-page-header">
        <div class="audit-page-title-block">
            <div class="audit-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
            </div>
            <div>
                <h1>Audit Logs</h1>
                <p class="audit-page-subtitle">Track and review system activities and changes.</p>
            </div>
        </div>
    </header>

    <div class="audit-card">
        <div class="audit-filters">
            <div class="audit-filter-field">
                <label for="audit-from">From</label>
                <input id="audit-from" type="date" @bind="_from" />
            </div>
            <div class="audit-filter-field">
                <label for="audit-to">To</label>
                <input id="audit-to" type="date" @bind="_to" />
            </div>
            <div class="audit-filter-field">
                <label for="audit-action">Action</label>
                <select id="audit-action" @bind="_action">
                    <option value="">All Actions</option>
                    @foreach (var a in Enum.GetValues<AuditAction>())
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </div>
            <button type="button" class="audit-btn-primary" @onclick="() => Load(1)">Filter</button>
            <button type="button" class="audit-btn-reset" @onclick="Reset">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="23 4 23 10 17 10"/>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
                Reset
            </button>
        </div>

        <div class="audit-table-wrap">
            <table class="audit-table">
                <thead>
                    <tr>
                        <th class="text-center"><button type="button" class="audit-th-sort @SortClass("date")" @onclick='() => SortBy("date")'>Date @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="audit-th-sort @SortClass("user")" @onclick='() => SortBy("user")'>User @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="audit-th-sort @SortClass("action")" @onclick='() => SortBy("action")'>Action @SortIcon</button></th>
                        <th class="text-center"><button type="button" class="audit-th-sort @SortClass("result")" @onclick='() => SortBy("result")'>Result @SortIcon</button></th>
                        <th class="text-center">Client</th>
                        <th class="text-center">Machine</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Reason</th>
                        <th class="text-center">Ticket</th>
                        <th class="text-center">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (DisplayItems.Count == 0)
                    {
                        <tr><td colspan="10" class="audit-empty">No audit logs found.</td></tr>
                    }
                    else
                    {
                        @foreach (var log in DisplayItems)
                        {
                            <tr>
                                <td>
                                    <span class="audit-date-cell">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                        </svg>
                                        @FormatDateTime(log.TimestampUtc)
                                    </span>
                                </td>
                                <td>
                                    <div class="audit-user-cell">
                                        <span class="audit-avatar" aria-hidden="true">@AvatarInitial(log.UserName)</span>
                                        <span class="audit-username">@(log.UserName ?? "—")</span>
                                    </div>
                                </td>
                                <td class="text-center">@log.Action</td>
                                <td>
                                    <span class="audit-result-badge @ResultClass(log.Result)">
                                        @if (log.Result == AuditResult.Success)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        }
                                        @log.Result
                                    </span>
                                </td>
                                <td class="text-center">@DisplayValue(log.ClientName)</td>
                                <td class="text-center">@DisplayValue(log.MachineName)</td>
                                <td class="text-center">@DisplayValue(log.CredentialType)</td>
                                <td class="text-center">@DisplayValue(log.Reason)</td>
                                <td class="text-center">@DisplayValue(log.InternalTicket)</td>
                                <td class="text-center">@DisplayValue(log.IpAddress)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="audit-footer">
            <span>Showing @RangeStart to @RangeEnd of @_page.TotalCount logs</span>
            <div class="audit-pagination">
                <button type="button" disabled="@(_page.Page <= 1)" @onclick="() => Load(_page.Page - 1)" aria-label="Previous page">‹</button>
                @for (var p = 1; p <= TotalPages; p++)
                {
                    var pageNum = p;
                    <button type="button" class="@(_page.Page == pageNum ? "active" : null)" @onclick="() => Load(pageNum)">@pageNum</button>
                }
                <button type="button" disabled="@(_page.Page >= TotalPages)" @onclick="() => Load(_page.Page + 1)" aria-label="Next page">›</button>
            </div>
        </footer>
    </div>
</div>

@code {
    private const int PageSize = 10;

    private DateTime? _from = DateTime.Today.AddDays(-7);
    private DateTime? _to = DateTime.Today;
    private string _action = "";
    private string _sortColumn = "date";
    private bool _sortAsc = false;

    private PagedResult<AuditLogDto> _page = new();
    private List<AuditLogDto> DisplayItems => SortItems(_page.Items);

    private int TotalPages => Math.Max(1, _page.TotalPages);
    private int RangeStart => _page.TotalCount == 0 ? 0 : (_page.Page - 1) * _page.PageSize + 1;
    private int RangeEnd => Math.Min(_page.Page * _page.PageSize, _page.TotalCount);

    private MarkupString SortIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">" +
        "<path d=\"m7 15 5 5 5-5\"/><path d=\"m7 9 5-4 5 4\"/></svg>");

    protected override async Task OnInitializedAsync() => await Load(1);

    private async Task Load(int page)
    {
        if (page < 1) return;

        AuditAction? action = Enum.TryParse<AuditAction>(_action, out var a) ? a : null;
        DateTime? fromUtc = _from.HasValue
            ? DateTime.SpecifyKind(_from.Value.Date, DateTimeKind.Local).ToUniversalTime()
            : null;
        DateTime? toUtc = _to.HasValue
            ? DateTime.SpecifyKind(_to.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime()
            : null;

        _page = await AuditSvc.QueryAsync(new AuditQueryFilter
        {
            FromUtc = fromUtc,
            ToUtc = toUtc,
            Action = action,
            Page = page,
            PageSize = PageSize
        });
    }

    private async Task Reset()
    {
        _from = DateTime.Today.AddDays(-7);
        _to = DateTime.Today;
        _action = "";
        _sortColumn = "date";
        _sortAsc = false;
        await Load(1);
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = column is "user" or "action" or "result";
        }
    }

    private string SortClass(string column) => _sortColumn == column ? "active" : "";

    private List<AuditLogDto> SortItems(IReadOnlyList<AuditLogDto> items)
    {
        IEnumerable<AuditLogDto> q = items;
        q = _sortColumn switch
        {
            "user" => _sortAsc ? q.OrderBy(i => i.UserName) : q.OrderByDescending(i => i.UserName),
            "action" => _sortAsc ? q.OrderBy(i => i.Action) : q.OrderByDescending(i => i.Action),
            "result" => _sortAsc ? q.OrderBy(i => i.Result) : q.OrderByDescending(i => i.Result),
            _ => _sortAsc ? q.OrderBy(i => i.TimestampUtc) : q.OrderByDescending(i => i.TimestampUtc)
        };
        return q.ToList();
    }

    private static string FormatDateTime(DateTime utc) =>
        utc.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private static string AvatarInitial(string? userName) =>
        string.IsNullOrWhiteSpace(userName) ? "?" : char.ToUpperInvariant(userName[0]).ToString();

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string ResultClass(AuditResult result) => result switch
    {
        AuditResult.Success => "audit-result-success",
        AuditResult.Denied => "audit-result-denied",
        AuditResult.Failure => "audit-result-failure",
        _ => "audit-result-failure"
    };
}
