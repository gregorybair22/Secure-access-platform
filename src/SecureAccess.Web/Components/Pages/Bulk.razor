@page "/bulk"
@attribute [Authorize(Policy = "perm:bulk.operations")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Bulk
@using SecureAccess.Application.Features.Machines
@using SecureAccess.Application.Features.Clients
@inject IBulkService BulkSvc
@inject IMachineService MachineSvc
@inject IClientService ClientSvc
@inject IToastService Toast

<PageTitle>Bulk Operations - Secure Access</PageTitle>

<div class="bulk-page">
    <header class="bulk-page-header">
        <div class="bulk-page-title-block">
            <div class="bulk-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="8" y="2" width="8" height="4" rx="1"/>
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <rect x="8" y="10" width="8" height="10" rx="1"/>
                </svg>
            </div>
            <div>
                <h1>
                    Bulk Operations
                    <span class="bulk-page-info" title="Copy credentials in bulk between machines or clients. Changes are audited.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="16" x2="12" y2="12"/>
                            <line x1="12" y1="8" x2="12.01" y2="8"/>
                        </svg>
                    </span>
                </h1>
                <p class="bulk-page-subtitle">Perform bulk actions to copy credentials, machines, or clients quickly and accurately.</p>
            </div>
        </div>
    </header>

    <div class="bulk-operations">
        <article class="bulk-op-card bulk-op-card-machines">
            <div class="bulk-op-card-header">
                <div class="bulk-op-card-icon bulk-op-card-icon-machines" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="2" width="20" height="8" rx="2"/>
                        <rect x="2" y="14" width="20" height="8" rx="2"/>
                        <line x1="6" y1="6" x2="6.01" y2="6"/>
                        <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                </div>
                <div>
                    <h2>Copy Credentials: Machines → Machines</h2>
                    <p>Copy credentials from one machine to multiple target machines.</p>
                </div>
            </div>
            <div class="bulk-op-card-body">
                <div class="bulk-op-form-grid">
                    <div class="bulk-op-field">
                        <label for="bulk-src-machine">Source Machine</label>
                        <select id="bulk-src-machine" class="bulk-select" @bind="_srcMachine" @bind:after="OnSourceMachineChanged">
                            <option value="0">Select source machine</option>
                            @foreach (var m in _machines)
                            {
                                <option value="@m.Id">@m.ClientName / @m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="bulk-op-field">
                        <label for="bulk-tgt-machines">Target Machines</label>
                        <select id="bulk-tgt-machines" class="bulk-select bulk-select-multi" multiple @onchange="OnTargetMachinesChanged">
                            @foreach (var m in _machines.Where(x => x.Id != _srcMachine))
                            {
                                <option value="@m.Id" selected="@_tgtMachines.Contains(m.Id)">@m.ClientName / @m.Name</option>
                            }
                        </select>
                        <p class="bulk-op-hint">Hold Ctrl (or Cmd) to select multiple.</p>
                    </div>
                </div>
                <div class="bulk-op-options">
                    <div class="bulk-option">
                        <input class="form-check-input" type="checkbox" @bind="_mFill" id="bulk-m-fill" />
                        <label for="bulk-m-fill">
                            <span class="bulk-option-title">Fill empty fields only</span>
                            <span class="bulk-option-desc">Only copy fields that are empty in target machines.</span>
                        </label>
                    </div>
                    <div class="bulk-option">
                        <input class="form-check-input" type="checkbox" @bind="_mOver" id="bulk-m-over" />
                        <label for="bulk-m-over">
                            <span class="bulk-option-title">Overwrite existing values</span>
                            <span class="bulk-option-desc">Replace existing values in target machines.</span>
                        </label>
                    </div>
                </div>
                <div class="bulk-op-actions">
                    <button type="button" class="bulk-btn-copy bulk-btn-copy-machines" disabled="@_busy" @onclick="CopyMachines">
                        @if (_busy && _busyOp == "machines")
                        {
                            <span class="bulk-btn-spinner" aria-hidden="true"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                            </svg>
                        }
                        Copy Credentials
                    </button>
                </div>
            </div>
        </article>

        <article class="bulk-op-card bulk-op-card-clients">
            <div class="bulk-op-card-header">
                <div class="bulk-op-card-icon bulk-op-card-icon-clients" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <h2>Copy Credentials: Clients → Clients</h2>
                    <p>Copy credentials from one client to multiple target clients.</p>
                </div>
            </div>
            <div class="bulk-op-card-body">
                <div class="bulk-op-form-grid">
                    <div class="bulk-op-field">
                        <label for="bulk-src-client">Source Client</label>
                        <select id="bulk-src-client" class="bulk-select" @bind="_srcClient" @bind:after="OnSourceClientChanged">
                            <option value="0">Select source client</option>
                            @foreach (var c in _clients)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="bulk-op-field">
                        <label for="bulk-tgt-clients">Target Clients</label>
                        <select id="bulk-tgt-clients" class="bulk-select bulk-select-multi" multiple @onchange="OnTargetClientsChanged">
                            @foreach (var c in _clients.Where(x => x.Id != _srcClient))
                            {
                                <option value="@c.Id" selected="@_tgtClients.Contains(c.Id)">@c.Name</option>
                            }
                        </select>
                        <p class="bulk-op-hint">Hold Ctrl (or Cmd) to select multiple.</p>
                    </div>
                </div>
                <div class="bulk-op-options">
                    <div class="bulk-option">
                        <input class="form-check-input" type="checkbox" @bind="_cFill" id="bulk-c-fill" />
                        <label for="bulk-c-fill">
                            <span class="bulk-option-title">Fill empty fields only</span>
                            <span class="bulk-option-desc">Only copy fields that are empty in target clients.</span>
                        </label>
                    </div>
                    <div class="bulk-option">
                        <input class="form-check-input" type="checkbox" @bind="_cOver" id="bulk-c-over" />
                        <label for="bulk-c-over">
                            <span class="bulk-option-title">Overwrite existing values</span>
                            <span class="bulk-option-desc">Replace existing values in target clients.</span>
                        </label>
                    </div>
                </div>
                <div class="bulk-op-actions">
                    <button type="button" class="bulk-btn-copy bulk-btn-copy-clients" disabled="@_busy" @onclick="CopyClients">
                        @if (_busy && _busyOp == "clients")
                        {
                            <span class="bulk-btn-spinner" aria-hidden="true"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                            </svg>
                        }
                        Copy Credentials
                    </button>
                </div>
            </div>
        </article>
    </div>
</div>

@code {
    private List<MachineDto> _machines = new();
    private List<ClientDto> _clients = new();
    private int _srcMachine;
    private int _srcClient;
    private List<int> _tgtMachines = new();
    private List<int> _tgtClients = new();
    private bool _mFill;
    private bool _mOver;
    private bool _cFill;
    private bool _cOver;
    private bool _busy;
    private string? _busyOp;

    protected override async Task OnInitializedAsync()
    {
        _machines = (await MachineSvc.GetMachinesAsync(null, null, 1, 500)).Items.ToList();
        _clients = (await ClientSvc.GetClientsAsync(null, 1, 500)).Items.ToList();
    }

    private void OnSourceMachineChanged() =>
        _tgtMachines = _tgtMachines.Where(id => id != _srcMachine).ToList();

    private void OnSourceClientChanged() =>
        _tgtClients = _tgtClients.Where(id => id != _srcClient).ToList();

    private void OnTargetMachinesChanged(ChangeEventArgs e) =>
        _tgtMachines = ParseSelectedIds(e);

    private void OnTargetClientsChanged(ChangeEventArgs e) =>
        _tgtClients = ParseSelectedIds(e);

    private static List<int> ParseSelectedIds(ChangeEventArgs e) =>
        (e.Value as string[])?
            .Select(v => int.TryParse(v, out var i) ? i : 0)
            .Where(i => i > 0)
            .Distinct()
            .ToList() ?? new();

    private async Task CopyMachines()
    {
        if (_srcMachine == 0 || _tgtMachines.Count == 0)
        {
            await Toast.ErrorAsync("Select a source machine and at least one target machine.");
            return;
        }

        _tgtMachines = _tgtMachines.Where(id => id != _srcMachine).Distinct().ToList();
        if (_tgtMachines.Count == 0)
        {
            await Toast.ErrorAsync("Select at least one target machine other than the source.");
            return;
        }

        _busy = true;
        _busyOp = "machines";
        try
        {
            var result = await BulkSvc.CopyMachineToMachinesAsync(new CopyMachineToMachinesRequest
            {
                SourceMachineId = _srcMachine,
                TargetMachineIds = _tgtMachines,
                FillEmptyOnly = _mFill,
                Overwrite = _mOver
            });

            if (!result.Succeeded)
            {
                await Toast.ErrorAsync(result.Error ?? "Copy failed.");
                return;
            }

            await Toast.SuccessAsync($"Copy complete: created {result.Value!.CreatedCredentials}, updated {result.Value.AffectedCredentials} credential(s).");
        }
        finally
        {
            _busy = false;
            _busyOp = null;
        }
    }

    private async Task CopyClients()
    {
        if (_srcClient == 0 || _tgtClients.Count == 0)
        {
            await Toast.ErrorAsync("Select a source client and at least one target client.");
            return;
        }

        _tgtClients = _tgtClients.Where(id => id != _srcClient).Distinct().ToList();
        if (_tgtClients.Count == 0)
        {
            await Toast.ErrorAsync("Select at least one target client other than the source.");
            return;
        }

        _busy = true;
        _busyOp = "clients";
        try
        {
            var result = await BulkSvc.CopyClientToClientsAsync(new CopyClientToClientsRequest
            {
                SourceClientId = _srcClient,
                TargetClientIds = _tgtClients,
                FillEmptyOnly = _cFill,
                Overwrite = _cOver
            });

            if (!result.Succeeded)
            {
                await Toast.ErrorAsync(result.Error ?? "Copy failed.");
                return;
            }

            await Toast.SuccessAsync($"Copy complete: created {result.Value!.CreatedCredentials}, updated {result.Value.AffectedCredentials} credential(s).");
        }
        finally
        {
            _busy = false;
            _busyOp = null;
        }
    }
}
