@page "/clients"
@attribute [Authorize(Policy = "perm:clients.view")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Clients.IClientService ClientSvc
@inject ICurrentUserService Current

<PageTitle>Clients - Secure Access</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clients</h1>
    @if (Current.HasPermission(Permissions.ClientsCreate))
    {
        <button class="btn btn-primary" @onclick="() => Edit(new())">New Client</button>
    }
</div>

<div class="input-group mb-3" style="max-width:400px">
    <input class="form-control" placeholder="Search name or code..." @bind="_search" @bind:event="oninput" @onkeyup="Reload" />
</div>

@if (_editing is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editing.Id == 0 ? "New Client" : $"Edit: {_editing.Name}")</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">Name *</label><input class="form-control" @bind="_form.Name" /></div>
                <div class="col-md-6"><label class="form-label">Customer Code *</label><input class="form-control" @bind="_form.CustomerCode" /></div>
                <div class="col-md-6"><label class="form-label">Contact Person</label><input class="form-control" @bind="_form.ContactPerson" /></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" @bind="_form.PhoneNumber" /></div>
                <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" @bind="_form.Email" /></div>
                <div class="col-md-6"><label class="form-label">Status</label>
                    <select class="form-select" @bind="_form.Status">
                        @foreach (var s in Enum.GetValues<EntityStatus>()) { <option value="@s">@s</option> }
                    </select>
                </div>
                <div class="col-12"><label class="form-label">Address</label><input class="form-control" @bind="_form.Address" /></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" @bind="_form.Notes"></textarea></div>
                <div class="col-12 form-check ms-2">
                    <input class="form-check-input" type="checkbox" @bind="_form.IsRestricted" id="restricted" />
                    <label class="form-check-label" for="restricted">Restricted (hidden from technicians)</label>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped table-hover">
    <thead><tr><th>Code</th><th>Name</th><th>Contact</th><th>Machines</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in _items)
        {
            <tr>
                <td>@c.CustomerCode</td>
                <td>@c.Name @(c.IsRestricted ? "🔒" : "")</td>
                <td>@c.ContactPerson</td>
                <td><a href="/machines?clientId=@c.Id">@c.MachineCount</a></td>
                <td>@c.Status</td>
                <td class="text-end">
                    @if (Current.HasPermission(Permissions.ClientsEdit))
                    { <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(c)">Edit</button> }
                    @if (Current.HasPermission(Permissions.ClientsDelete))
                    { <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(c.Id)">Delete</button> }
                </td>
            </tr>
        }
        @if (_items.Count == 0) { <tr><td colspan="6" class="text-muted">No clients found.</td></tr> }
    </tbody>
</table>

@code {
    private List<SecureAccess.Application.Features.Clients.ClientDto> _items = new();
    private string? _search;
    private SecureAccess.Application.Features.Clients.ClientDto? _editing;
    private SecureAccess.Application.Features.Clients.SaveClientRequest _form = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var page = await ClientSvc.GetClientsAsync(_search, 1, 100);
        _items = page.Items.ToList();
    }

    private void Edit(SecureAccess.Application.Features.Clients.ClientDto c)
    {
        _error = null;
        _editing = c;
        _form = new()
        {
            Name = c.Name, CustomerCode = c.CustomerCode, Address = c.Address,
            ContactPerson = c.ContactPerson, PhoneNumber = c.PhoneNumber, Email = c.Email,
            Notes = c.Notes, Status = c.Status == 0 ? EntityStatus.Active : c.Status, IsRestricted = c.IsRestricted
        };
    }

    private async Task Save()
    {
        var result = _editing!.Id == 0
            ? (Result)await ClientSvc.CreateAsync(_form)
            : await ClientSvc.UpdateAsync(_editing.Id, _form);
        if (!result.Succeeded) { _error = result.Error; return; }
        _editing = null;
        await Reload();
    }

    private async Task Delete(int id)
    {
        await ClientSvc.DeleteAsync(id);
        await Reload();
    }
}
