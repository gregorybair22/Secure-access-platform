@page "/reports"
@attribute [Authorize(Policy = "perm:reports.view")]
@rendermode InteractiveServer
<PageTitle>Reports - Secure Access</PageTitle>

<div class="reports-page">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="reports-page-alert" role="alert">@_error</div>
    }

    <header class="reports-page-header">
        <div class="reports-page-title-block">
            <div class="reports-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
            </div>
            <div>
                <h1>Reports</h1>
                <p class="reports-page-subtitle">View and export credential access logs and activities.</p>
            </div>
        </div>
    </header>

    <div class="reports-stats">
        <article class="reports-stat-card">
            <div class="reports-stat-icon reports-stat-icon-total" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <div>
                <p class="reports-stat-label">Total Logs</p>
                <p class="reports-stat-value">@_stats.TotalLogs</p>
                <p class="reports-stat-hint">All time logs</p>
            </div>
        </article>
        <article class="reports-stat-card">
            <div class="reports-stat-icon reports-stat-icon-month" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div>
                <p class="reports-stat-label">Logs This Month</p>
                <p class="reports-stat-value">@_stats.LogsThisMonth</p>
                <p class="reports-stat-hint">@MonthLabel</p>
            </div>
        </article>
        <article class="reports-stat-card">
            <div class="reports-stat-icon reports-stat-icon-users" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div>
                <p class="reports-stat-label">Unique Users</p>
                <p class="reports-stat-value">@_stats.UniqueUsers</p>
                <p class="reports-stat-hint">All time</p>
            </div>
        </article>
        <article class="reports-stat-card">
            <div class="reports-stat-icon reports-stat-icon-machines" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
            </div>
            <div>
                <p class="reports-stat-label">Unique Machines</p>
                <p class="reports-stat-value">@_stats.UniqueMachines</p>
                <p class="reports-stat-hint">All time</p>
            </div>
        </article>
    </div>

    <div class="reports-filters-card">
        <div class="reports-filters">
            <div class="reports-filter-field">
                <label for="reports-type">Report</label>
                <select id="reports-type" class="reports-select" @bind="_report">
                    <option value="credential-access">Credential Access</option>
                    <option value="technician-activity">Technician Activity</option>
                    <option value="customer-access">Customer Access</option>
                    <option value="machine-access">Machine Access</option>
                    <option value="credential-usage">Credential Usage</option>
                    <option value="reason-analysis">Reason Analysis</option>
                    <option value="change-history">Change History</option>
                </select>
            </div>
            <div class="reports-filter-field">
                <label for="reports-from">From</label>
                <input id="reports-from" type="date" class="reports-date" @bind="_from" />
            </div>
            <div class="reports-filter-field">
                <label for="reports-to">To</label>
                <input id="reports-to" type="date" class="reports-date" @bind="_to" />
            </div>
            <div class="reports-filter-actions">
                <button type="button" class="reports-btn-primary" disabled="@_busy" @onclick="Run">
                    @if (_busy)
                    {
                        <span class="reports-btn-spinner" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <polygon points="5 3 19 12 5 21 5 3"/>
                        </svg>
                    }
                    Run Report
                </button>
                <div class="reports-export-wrap">
                    <button type="button" class="reports-btn-export" disabled="@(!CanExport)" @onclick="ExportCsv" title="Export as CSV">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        Export
                        <svg class="reports-export-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="reports-card">
        <div class="reports-card-toolbar">
            <span class="reports-results-count">@FilteredCount Results</span>
            <div class="reports-toolbar-right">
                <div class="reports-toolbar-search">
                    <svg class="reports-toolbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="search" placeholder="Search results..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" disabled="@(!_hasRun)" />
                </div>
                <button type="button" class="reports-btn-outline" title="Filters" disabled="@(!_hasRun)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                    </svg>
                </button>
            </div>
        </div>

        @if (!_hasRun)
        {
            <div class="reports-empty-state">
                <div class="reports-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                        <line x1="12" y1="11" x2="12" y2="17"/>
                        <line x1="9" y1="14" x2="15" y2="14"/>
                    </svg>
                </div>
                <h2>No data found</h2>
                <p>Run a report to view results here.</p>
            </div>
        }
        else if (PagedRows.Count == 0)
        {
            <div class="reports-empty-state">
                <div class="reports-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                        <line x1="12" y1="11" x2="12" y2="17"/>
                        <line x1="9" y1="14" x2="15" y2="14"/>
                    </svg>
                </div>
                <h2>No data found</h2>
                <p>No data for the selected range. Try adjusting your dates or report type.</p>
            </div>
        }
        else
        {
            <div class="reports-table-wrap">
                <table class="reports-table">
                    <thead>
                        <tr>
                            @for (var i = 0; i < _headers!.Count; i++)
                            {
                                var col = i;
                                var header = _headers[col];
                                <th>
                                    <button type="button" class="reports-th-sort @SortClass(col)" @onclick="() => SortBy(col)">
                                        @header
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="m7 15 5 5 5-5"/><path d="m7 9 5 4 5 4"/>
                                        </svg>
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td>@(string.IsNullOrWhiteSpace(cell) ? "—" : cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="reports-footer">
            <span>@FooterSummary</span>
            <div class="reports-footer-right">
                <label class="reports-page-size">
                    Rows per page:
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged" disabled="@(!_hasRun)">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </label>
                <div class="reports-pager">
                    <button type="button" class="reports-pager-btn" disabled="@(_page <= 1 || !_hasRun)" @onclick="PrevPage" aria-label="Previous page">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                    </button>
                    <button type="button" class="reports-pager-btn" disabled="@(_page >= TotalPages || !_hasRun)" @onclick="NextPage" aria-label="Next page">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>
            </div>
        </footer>
    </div>
</div>
