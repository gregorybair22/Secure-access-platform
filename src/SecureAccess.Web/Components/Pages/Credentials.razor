@page "/credentials"
@attribute [Authorize(Policy = "perm:credentials.view")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Credentials
@using SecureAccess.Application.Features.Machines
@using SecureAccess.Application.Features.Clients
@using SecureAccess.Application.Common
@inject ICredentialService CredentialSvc
@inject ICredentialTypeService TypeSvc
@inject IMachineService MachineSvc
@inject IClientService ClientSvc
@inject ICurrentUserService Current

<PageTitle>Credentials - Secure Access</PageTitle>

<div class="credentials-page">
    @if (!string.IsNullOrEmpty(_error) && _editing is null && _deleteTarget is null)
    {
        <div class="credentials-page-alert" role="alert">@_error</div>
    }

    <header class="credentials-page-header">
        <div class="credentials-page-title-block">
            <div class="credentials-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <div>
                <h1>Credential Management</h1>
                <p class="credentials-page-subtitle">Manage and view credentials securely across your organization.</p>
            </div>
        </div>
        @if (Current.HasPermission(Permissions.CredentialsCreate))
        {
            <button type="button" class="credentials-btn-primary" @onclick="StartNew" disabled="@(!CanCreate)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Credential
            </button>
        }
    </header>

    <div class="credentials-scope-tabs" role="tablist" aria-label="Credential scope">
        <button type="button" role="tab" class="credentials-scope-tab @(_view == "machine" ? "active" : null)" aria-selected="@(_view == "machine")" @onclick='() => SwitchViewAsync("machine")'>By Machine</button>
        <button type="button" role="tab" class="credentials-scope-tab @(_view == "client" ? "active" : null)" aria-selected="@(_view == "client")" @onclick='() => SwitchViewAsync("client")'>Client Level</button>
        <button type="button" role="tab" class="credentials-scope-tab @(_view == "global" ? "active" : null)" aria-selected="@(_view == "global")" @onclick='() => SwitchViewAsync("global")'>Global</button>
    </div>

    @if (_view == "machine")
    {
        <div class="credentials-context-select">
            <label for="cred-machine-select">Machine</label>
            <select id="cred-machine-select" class="credentials-context-dropdown" @bind="_machineId" @bind:after="OnContextChanged">
                <option value="0">Select a machine...</option>
                @foreach (var m in _machines)
                {
                    <option value="@m.Id">@m.ClientName / @m.Name</option>
                }
            </select>
        </div>
    }
    else if (_view == "client")
    {
        <div class="credentials-context-select">
            <label for="cred-client-select">Client</label>
            <select id="cred-client-select" class="credentials-context-dropdown" @bind="_clientId" @bind:after="OnContextChanged">
                <option value="0">Select a client...</option>
                @foreach (var c in _clients)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
    }

    <div class="credentials-stats">
        <article class="credentials-stat-card">
            <div class="credentials-stat-icon credentials-stat-icon-total" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <div>
                <p class="credentials-stat-label">Total Credentials</p>
                <p class="credentials-stat-value">@Stats.Total</p>
                <p class="credentials-stat-hint">In current view</p>
            </div>
        </article>
        <article class="credentials-stat-card">
            <div class="credentials-stat-icon credentials-stat-icon-active" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <p class="credentials-stat-label">Active Credentials</p>
                <p class="credentials-stat-value">@Stats.Active</p>
                <p class="credentials-stat-hint">Currently active</p>
            </div>
        </article>
        <article class="credentials-stat-card">
            <div class="credentials-stat-icon credentials-stat-icon-inactive" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <line x1="7" y1="11" x2="7" y2="7"/>
                </svg>
            </div>
            <div>
                <p class="credentials-stat-label">Inactive Credentials</p>
                <p class="credentials-stat-value">@Stats.Inactive</p>
                <p class="credentials-stat-hint">Require attention</p>
            </div>
        </article>
        <article class="credentials-stat-card">
            <div class="credentials-stat-icon credentials-stat-icon-expired" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div>
                <p class="credentials-stat-label">Expired Credentials</p>
                <p class="credentials-stat-value">@Stats.Expired</p>
                <p class="credentials-stat-hint">Past validity</p>
            </div>
        </article>
    </div>

    <div class="credentials-card">
        <div class="credentials-toolbar">
            <div class="credentials-toolbar-search">
                <svg class="credentials-toolbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="search" placeholder="Search by label or type..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" disabled="@(!HasContext)" />
            </div>
            <select @bind="_activeFilter" @bind:after="ResetPage" aria-label="Filter by status" disabled="@(!HasContext)">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <button type="button" class="credentials-btn-outline" title="Filters" disabled="@(!HasContext)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Filter
            </button>
        </div>

        @if (!HasContext)
        {
            <div class="credentials-empty-state">
                <div class="credentials-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a4 4 0 0 0-8 0v2"/>
                    </svg>
                </div>
                <h2>Select a @ContextLabel</h2>
                <p>Choose a @ContextLabel.ToLower() above to view and manage credentials.</p>
            </div>
        }
        else if (PagedItems.Count == 0)
        {
            <div class="credentials-empty-state">
                <div class="credentials-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a4 4 0 0 0-8 0v2"/>
                        <circle cx="12" cy="14" r="2"/>
                    </svg>
                </div>
                <h2>No credentials found</h2>
                <p>@EmptyStateMessage</p>
                <a class="credentials-btn-primary" href="@RequestAccessHref">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    Request Credential
                </a>
                @if (Current.HasPermission(Permissions.CredentialsCreate))
                {
                    <button type="button" class="credentials-btn-secondary credentials-empty-new" @onclick="StartNew">New Credential</button>
                }
            </div>
        }
        else
        {
            <div class="credentials-table-wrap">
                <table class="credentials-table">
                    <thead>
                        <tr>
                            <th class="text-center"><button type="button" class="credentials-th-sort @SortClass("label")" @onclick='() => SortBy("label")'>Label @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="credentials-th-sort @SortClass("type")" @onclick='() => SortBy("type")'>Type @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="credentials-th-sort @SortClass("scope")" @onclick='() => SortBy("scope")'>Scope @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="credentials-th-sort @SortClass("active")" @onclick='() => SortBy("active")'>Active @SortIcon</button></th>
                            <th class="text-center credentials-th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in PagedItems)
                        {
                            <tr>
                                <td class="text-center"><span class="credentials-label">@(string.IsNullOrWhiteSpace(c.Label) ? "—" : c.Label)</span></td>
                                <td class="text-center">@c.CredentialTypeName</td>
                                <td class="text-center"><span class="credentials-scope-badge">@FormatScope(c.Scope)</span></td>
                                <td class="text-center">
                                    <span class="credentials-active-badge @(c.IsActive ? "credentials-active-yes" : "credentials-active-no")">
                                        @(c.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="credentials-actions">
                                        @if (Current.HasPermission(Permissions.CredentialsEdit))
                                        {
                                            <button type="button" class="credentials-btn-edit" @onclick="() => EditExisting(c.Id)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit
                                            </button>
                                        }
                                        @if (Current.HasPermission(Permissions.CredentialsDelete))
                                        {
                                            <button type="button" class="credentials-btn-delete" @onclick="() => OpenDeleteConfirm(c)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                                </svg>
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="credentials-footer">
            <span>Showing @RangeStart to @RangeEnd of @FilteredCount credentials</span>
            <div class="credentials-footer-right">
                <label class="credentials-page-size">
                    Rows per page:
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <div class="credentials-pagination">
                    <button type="button" disabled="@(_page <= 1)" @onclick="FirstPage" aria-label="First page">«</button>
                    <button type="button" disabled="@(_page <= 1)" @onclick="PrevPage" aria-label="Previous page">‹</button>
                    @for (var p = 1; p <= TotalPages; p++)
                    {
                        var pageNum = p;
                        <button type="button" class="@(_page == pageNum ? "active" : null)" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="NextPage" aria-label="Next page">›</button>
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="LastPage" aria-label="Last page">»</button>
                </div>
            </div>
        </footer>
    </div>
</div>

@if (_deleteTarget is not null)
{
    <div class="sa-modal-backdrop credentials-modal-backdrop @(_deleteModalClosing ? "is-closing" : null)" @onclick="CloseDeleteModalAsync">
        <div class="sa-modal-panel credentials-modal credentials-modal-confirm" role="alertdialog" aria-modal="true" aria-labelledby="credentials-delete-title" @onclick:stopPropagation="true">
            <div class="credentials-modal-header credentials-modal-header-danger">
                <div class="credentials-delete-header-main">
                    <div class="credentials-delete-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <div>
                        <h2 id="credentials-delete-title">Delete credential</h2>
                        <p class="credentials-modal-subtitle">This action cannot be undone.</p>
                    </div>
                </div>
                <button type="button" class="credentials-modal-close" aria-label="Close" @onclick="CloseDeleteModalAsync">×</button>
            </div>
            <div class="credentials-modal-body">
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="credentials-modal-alert" role="alert">@_deleteError</div>
                }
                <p class="credentials-delete-message">
                    Are you sure you want to delete <strong>@(_deleteTarget.Label)</strong> (@_deleteTarget.CredentialTypeName)?
                </p>
            </div>
            <div class="credentials-modal-footer">
                <button type="button" class="credentials-btn-secondary" @onclick="CloseDeleteModalAsync">Cancel</button>
                <button type="button" class="credentials-btn-danger" @onclick="ConfirmDeleteAsync">Delete credential</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="sa-modal-backdrop credentials-modal-backdrop @(_editModalClosing ? "is-closing" : null)" @onclick="CloseEditModalAsync">
        <div class="sa-modal-panel credentials-modal credentials-modal-wide" role="dialog" aria-modal="true" aria-labelledby="credentials-modal-title" @onclick:stopPropagation="true">
            <div class="credentials-modal-header">
                <h2 id="credentials-modal-title">@(_editingId == 0 ? "New Credential" : "Edit Credential")</h2>
                <button type="button" class="credentials-modal-close" aria-label="Close" @onclick="CloseEditModalAsync">×</button>
            </div>
            <div class="credentials-modal-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="credentials-modal-alert" role="alert">@_error</div>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Type *</label>
                        <select class="form-select" @bind="_editing.CredentialTypeId" @bind:after="OnTypeChanged" disabled="@(_editingId != 0)">
                            <option value="0">-- select --</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Scope</label>
                        <select class="form-select" @bind="_editing.Scope" disabled="@(_editingId != 0)">
                            @foreach (var s in Enum.GetValues<CredentialScope>())
                            {
                                <option value="@s">@FormatScope(s)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Label</label>
                        <input class="form-control" @bind="_editing.Label" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="_editing.IsActive" id="cred-active" />
                            <label class="form-check-label" for="cred-active">Active</label>
                        </div>
                    </div>
                </div>

                @if (_selectedType is not null)
                {
                    <h3 class="credentials-fields-heading">Field values</h3>
                    <div class="row g-3">
                        @foreach (var f in _selectedType.Fields.OrderBy(x => x.Order))
                        {
                            <div class="col-md-6">
                                <label class="form-label">@f.Label @(f.IsRequired ? "*" : "")</label>
                                @if (f.Type == CredentialFieldType.MultiLine)
                                {
                                    <textarea class="form-control" rows="2" @bind="_fieldValues[f.Key]"></textarea>
                                }
                                else if (f.Type == CredentialFieldType.Password)
                                {
                                    <input class="form-control" type="password" @bind="_fieldValues[f.Key]" placeholder="Secret (encrypted at rest)" autocomplete="new-password" />
                                }
                                else
                                {
                                    <input class="form-control" @bind="_fieldValues[f.Key]" />
                                }
                            </div>
                        }
                    </div>
                }

                <div class="mt-3">
                    <label class="form-label">Reason for change</label>
                    <input class="form-control" @bind="_editing.ChangeReason" placeholder="Recorded in change history when editing" />
                </div>
            </div>
            <div class="credentials-modal-footer">
                <div class="credentials-modal-footer-actions">
                    <button type="button" class="credentials-btn-secondary" @onclick="CloseEditModalAsync">Cancel</button>
                    <button type="button" class="credentials-btn-primary" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _view = "machine";
    private int _machineId;
    private int _clientId;
    private List<CredentialDto> _items = new();
    private List<CredentialTypeDto> _types = new();
    private List<MachineDto> _machines = new();
    private List<ClientDto> _clients = new();

    private SaveCredentialRequest? _editing;
    private bool _editModalClosing;
    private bool _deleteModalClosing;
    private int _editingId;
    private CredentialTypeDto? _selectedType;
    private Dictionary<string, string?> _fieldValues = new();
    private string? _error;
    private CredentialDto? _deleteTarget;
    private string? _deleteError;

    private string _search = "";
    private string _activeFilter = "";
    private string _sortColumn = "label";
    private bool _sortAsc = true;
    private int _page = 1;
    private int _pageSize = 10;

    [SupplyParameterFromQuery] public int? MachineId { get; set; }

    private bool HasContext => _view switch
    {
        "machine" => _machineId > 0,
        "client" => _clientId > 0,
        "global" => true,
        _ => false
    };

    private bool CanCreate => HasContext;

    private string ContextLabel => _view switch
    {
        "client" => "client",
        "global" => "global scope",
        _ => "machine"
    };

    private string EmptyStateMessage => _view switch
    {
        "client" => "There are no credentials for the selected client.",
        "global" => "There are no global credentials yet.",
        _ => "There are no credentials for the selected machine."
    };

    private string RequestAccessHref => _view == "machine" && _machineId > 0
        ? $"/request-access?machineId={_machineId}"
        : "/request-access";

    private CredentialStats Stats => new()
    {
        Total = _items.Count,
        Active = _items.Count(c => c.IsActive),
        Inactive = _items.Count(c => !c.IsActive),
        Expired = 0
    };

    private MarkupString SortIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">" +
        "<path d=\"m7 15 5 5 5-5\"/><path d=\"m7 9 5-4 5 4\"/></svg>");

    private IEnumerable<CredentialDto> FilteredItems
    {
        get
        {
            IEnumerable<CredentialDto> q = _items;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                q = q.Where(c =>
                    c.Label.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    c.CredentialTypeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    FormatScope(c.Scope).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            q = _activeFilter switch
            {
                "active" => q.Where(c => c.IsActive),
                "inactive" => q.Where(c => !c.IsActive),
                _ => q
            };

            q = _sortColumn switch
            {
                "type" => _sortAsc ? q.OrderBy(c => c.CredentialTypeName) : q.OrderByDescending(c => c.CredentialTypeName),
                "scope" => _sortAsc ? q.OrderBy(c => c.Scope) : q.OrderByDescending(c => c.Scope),
                "active" => _sortAsc ? q.OrderBy(c => c.IsActive) : q.OrderByDescending(c => c.IsActive),
                _ => _sortAsc ? q.OrderBy(c => c.Label) : q.OrderByDescending(c => c.Label)
            };

            return q;
        }
    }

    private int FilteredCount => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));
    private List<CredentialDto> PagedItems =>
        FilteredItems.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int RangeStart => FilteredCount == 0 ? 0 : (_page - 1) * _pageSize + 1;
    private int RangeEnd => Math.Min(_page * _pageSize, FilteredCount);

    protected override async Task OnInitializedAsync()
    {
        _types = (await TypeSvc.GetTypesAsync()).ToList();
        _machines = (await MachineSvc.GetMachinesAsync(null, null, 1, 500)).Items.ToList();
        _clients = (await ClientSvc.GetClientsAsync(null, 1, 500)).Items.ToList();
        if (MachineId is { } mid)
        {
            _machineId = mid;
            _view = "machine";
        }
        await Reload();
    }

    private async Task SwitchViewAsync(string v)
    {
        _view = v;
        _editing = null;
        _error = null;
        ResetPage();
        await Reload();
    }

    private async Task OnContextChanged()
    {
        ResetPage();
        await Reload();
    }

    private async Task Reload()
    {
        _items = _view switch
        {
            "machine" when _machineId > 0 => (await CredentialSvc.GetForMachineAsync(_machineId)).ToList(),
            "client" when _clientId > 0 => (await CredentialSvc.GetForClientAsync(_clientId)).ToList(),
            "global" => (await CredentialSvc.GetGlobalAsync()).ToList(),
            _ => new()
        };
        if (_page > TotalPages) _page = TotalPages;
    }

    private void StartNew()
    {
        if (!CanCreate) return;
        _error = null;
        _editingId = 0;
        _editing = new SaveCredentialRequest
        {
            Scope = _view == "global" ? CredentialScope.Global : _view == "client" ? CredentialScope.Client : CredentialScope.Machine,
            ClientId = _clientId == 0 ? null : _clientId,
            MachineId = _machineId == 0 ? null : _machineId,
            IsActive = true
        };
        _selectedType = null;
        _fieldValues = new();
    }

    private void OnTypeChanged()
    {
        _selectedType = _types.FirstOrDefault(t => t.Id == _editing!.CredentialTypeId);
        _fieldValues = new();
        if (_selectedType is not null)
            foreach (var f in _selectedType.Fields)
                _fieldValues[f.Key] = null;
    }

    private async Task EditExisting(int id)
    {
        var c = await CredentialSvc.GetAsync(id);
        if (c is null) return;
        _error = null;
        _editingId = id;
        _editing = new SaveCredentialRequest
        {
            CredentialTypeId = c.CredentialTypeId,
            Scope = c.Scope,
            ClientId = c.ClientId,
            MachineId = c.MachineId,
            Label = c.Label,
            Notes = c.Notes,
            IsActive = c.IsActive
        };
        _selectedType = _types.FirstOrDefault(t => t.Id == c.CredentialTypeId)
            ?? await TypeSvc.GetTypeAsync(c.CredentialTypeId);
        _fieldValues = new();
        if (_selectedType is not null)
            foreach (var f in _selectedType.Fields)
                _fieldValues[f.Key] = c.PlainValues.TryGetValue(f.Key, out var v) ? v : null;
    }

    private void OpenDeleteConfirm(CredentialDto c)
    {
        _deleteTarget = c;
        _deleteError = null;
    }

    private Task CloseEditModalAsync()
    {
        if (_editing is null || _editModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _editModalClosing,
            v => _editModalClosing = v,
            () => _editing = null,
            StateHasChanged);
    }

    private Task CloseDeleteModalAsync()
    {
        if (_deleteTarget is null || _deleteModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _deleteModalClosing,
            v => _deleteModalClosing = v,
            () => _deleteTarget = null,
            StateHasChanged);
    }

    private static string FormatScope(CredentialScope scope) => scope switch
    {
        CredentialScope.Machine => "Machine",
        CredentialScope.Client => "Client",
        CredentialScope.Global => "Global",
        _ => scope.ToString()
    };

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = true;
        }
        _page = 1;
    }

    private string SortClass(string column) => _sortColumn == column ? "active" : "";

    private void ResetPage() => _page = 1;

    private void OnPageSizeChanged()
    {
        _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void FirstPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void LastPage() => _page = TotalPages;
    private void GoToPage(int p) => _page = p;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;

        _deleteError = null;
        var result = await CredentialSvc.DeleteAsync(_deleteTarget.Id);
        if (!result.Succeeded)
        {
            _deleteError = result.Error;
            return;
        }

        if (_editingId == _deleteTarget.Id)
            _editing = null;

        await CloseDeleteModalAsync();
        await Reload();
    }

    private async Task Save()
    {
        if (_editing!.CredentialTypeId == 0)
        {
            _error = "Select a credential type.";
            return;
        }

        _editing.Scope = _view == "global" ? CredentialScope.Global : _editing.Scope;
        if (_editing.Scope == CredentialScope.Machine)
            _editing.MachineId = _machineId == 0 ? _editing.MachineId : _machineId;
        if (_editing.Scope == CredentialScope.Client)
            _editing.ClientId = _clientId == 0 ? _editing.ClientId : _clientId;
        _editing.Values = _fieldValues;

        Result result;
        if (_editingId == 0)
            result = await CredentialSvc.CreateAsync(_editing);
        else
            result = await CredentialSvc.UpdateAsync(_editingId, _editing);

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        await CloseEditModalAsync();
        await Reload();
    }

    private sealed class CredentialStats
    {
        public int Total { get; set; }
        public int Active { get; set; }
        public int Inactive { get; set; }
        public int Expired { get; set; }
    }
}
