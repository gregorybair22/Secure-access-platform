@page "/credentials"
@attribute [Authorize(Policy = "perm:credentials.view")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Credentials.ICredentialService CredentialSvc
@inject SecureAccess.Application.Features.Credentials.ICredentialTypeService TypeSvc
@inject SecureAccess.Application.Features.Machines.IMachineService MachineSvc
@inject SecureAccess.Application.Features.Clients.IClientService ClientSvc
@inject ICurrentUserService Current

<PageTitle>Credentials - Secure Access</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Credential Management</h1>
    @if (Current.HasPermission(Permissions.CredentialsCreate))
    {
        <button class="btn btn-primary" @onclick="StartNew">New Credential</button>
    }
</div>

<div class="btn-group mb-3">
    <button class="btn @(_view == "machine" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchView("machine")'>By Machine</button>
    <button class="btn @(_view == "client" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchView("client")'>Client-Level</button>
    <button class="btn @(_view == "global" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchView("global")'>Global</button>
</div>

@if (_view == "machine")
{
    <select class="form-select mb-3" style="max-width:400px" @bind="_machineId" @bind:after="Reload">
        <option value="0">-- select machine --</option>
        @foreach (var m in _machines) { <option value="@m.Id">@m.ClientName / @m.Name</option> }
    </select>
}
else if (_view == "client")
{
    <select class="form-select mb-3" style="max-width:400px" @bind="_clientId" @bind:after="Reload">
        <option value="0">-- select client --</option>
        @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
    </select>
}

@if (_editing is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editingId == 0 ? "New Credential" : "Edit Credential")</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label">Type *</label>
                    <select class="form-select" @bind="_editing.CredentialTypeId" @bind:after="OnTypeChanged" disabled="@(_editingId != 0)">
                        <option value="0">-- select --</option>
                        @foreach (var t in _types) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">Scope</label>
                    <select class="form-select" @bind="_editing.Scope" disabled="@(_editingId != 0)">
                        @foreach (var s in Enum.GetValues<CredentialScope>()) { <option value="@s">@s</option> }
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">Label</label><input class="form-control" @bind="_editing.Label" /></div>
            </div>

            @if (_selectedType is not null)
            {
                <hr />
                <div class="row g-2">
                    @foreach (var f in _selectedType.Fields)
                    {
                        <div class="col-md-6">
                            <label class="form-label">@f.Label @(f.IsRequired ? "*" : "")</label>
                            @if (f.Type == CredentialFieldType.MultiLine)
                            {
                                <textarea class="form-control" @bind="_fieldValues[f.Key]"></textarea>
                            }
                            else if (f.Type == CredentialFieldType.Password)
                            {
                                <input class="form-control" type="text" @bind="_fieldValues[f.Key]" placeholder="(secret - encrypted at rest)" />
                            }
                            else
                            {
                                <input class="form-control" @bind="_fieldValues[f.Key]" />
                            }
                        </div>
                    }
                </div>
            }

            <div class="mt-3">
                <input class="form-control mb-2" @bind="_editing.ChangeReason" placeholder="Reason for change (recorded in history)" />
                <button class="btn btn-success" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped">
    <thead><tr><th>Label</th><th>Type</th><th>Scope</th><th>Active</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in _items)
        {
            <tr>
                <td>@c.Label</td>
                <td>@c.CredentialTypeName</td>
                <td>@c.Scope</td>
                <td>@(c.IsActive ? "Yes" : "No")</td>
                <td class="text-end">
                    @if (Current.HasPermission(Permissions.CredentialsEdit))
                    { <button class="btn btn-sm btn-outline-primary" @onclick="() => EditExisting(c.Id)">Edit</button> }
                    @if (Current.HasPermission(Permissions.CredentialsDelete))
                    { <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(c.Id)">Delete</button> }
                </td>
            </tr>
        }
        @if (_items.Count == 0) { <tr><td colspan="5" class="text-muted">No credentials. Use the request workflow to view secrets.</td></tr> }
    </tbody>
</table>

@code {
    private string _view = "machine";
    private int _machineId;
    private int _clientId;
    private List<SecureAccess.Application.Features.Credentials.CredentialDto> _items = new();
    private List<SecureAccess.Application.Features.Credentials.CredentialTypeDto> _types = new();
    private List<SecureAccess.Application.Features.Machines.MachineDto> _machines = new();
    private List<SecureAccess.Application.Features.Clients.ClientDto> _clients = new();

    private SecureAccess.Application.Features.Credentials.SaveCredentialRequest? _editing;
    private int _editingId;
    private SecureAccess.Application.Features.Credentials.CredentialTypeDto? _selectedType;
    private Dictionary<string, string?> _fieldValues = new();
    private string? _error;

    [SupplyParameterFromQuery] public int? MachineId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _types = (await TypeSvc.GetTypesAsync()).ToList();
        _machines = (await MachineSvc.GetMachinesAsync(null, null, 1, 500)).Items.ToList();
        _clients = (await ClientSvc.GetClientsAsync(null, 1, 500)).Items.ToList();
        if (MachineId is { } mid) { _machineId = mid; }
        await Reload();
    }

    private async Task SwitchView(string v) { _view = v; _editing = null; await Reload(); }

    private async Task Reload()
    {
        _items = _view switch
        {
            "machine" when _machineId > 0 => (await CredentialSvc.GetForMachineAsync(_machineId)).ToList(),
            "client" when _clientId > 0 => (await CredentialSvc.GetForClientAsync(_clientId)).ToList(),
            "global" => (await CredentialSvc.GetGlobalAsync()).ToList(),
            _ => new()
        };
    }

    private void StartNew()
    {
        _error = null; _editingId = 0;
        _editing = new()
        {
            Scope = _view == "global" ? CredentialScope.Global : _view == "client" ? CredentialScope.Client : CredentialScope.Machine,
            ClientId = _clientId == 0 ? null : _clientId,
            MachineId = _machineId == 0 ? null : _machineId
        };
        _selectedType = null;
        _fieldValues = new();
    }

    private void OnTypeChanged()
    {
        _selectedType = _types.FirstOrDefault(t => t.Id == _editing!.CredentialTypeId);
        _fieldValues = new();
        if (_selectedType is not null)
            foreach (var f in _selectedType.Fields) _fieldValues[f.Key] = null;
    }

    private async Task EditExisting(int id)
    {
        var c = await CredentialSvc.GetAsync(id);
        if (c is null) return;
        _error = null; _editingId = id;
        _editing = new()
        {
            CredentialTypeId = c.CredentialTypeId, Scope = c.Scope,
            ClientId = c.ClientId, MachineId = c.MachineId, Label = c.Label,
            Notes = c.Notes, IsActive = c.IsActive
        };
        _selectedType = _types.FirstOrDefault(t => t.Id == c.CredentialTypeId)
            ?? await TypeSvc.GetTypeAsync(c.CredentialTypeId);
        _fieldValues = new();
        if (_selectedType is not null)
            foreach (var f in _selectedType.Fields)
                _fieldValues[f.Key] = c.PlainValues.TryGetValue(f.Key, out var v) ? v : null;
    }

    private async Task Save()
    {
        if (_editing!.CredentialTypeId == 0) { _error = "Select a credential type."; return; }
        _editing.Scope = _view == "global" ? CredentialScope.Global : _editing.Scope;
        if (_editing.Scope == CredentialScope.Machine) _editing.MachineId = _machineId == 0 ? _editing.MachineId : _machineId;
        if (_editing.Scope == CredentialScope.Client) _editing.ClientId = _clientId == 0 ? _editing.ClientId : _clientId;
        _editing.Values = _fieldValues;

        var result = _editingId == 0 ? (Result)await CredentialSvc.CreateAsync(_editing) : await CredentialSvc.UpdateAsync(_editingId, _editing);
        if (!result.Succeeded) { _error = result.Error; return; }
        _editing = null;
        await Reload();
    }

    private async Task Delete(int id)
    {
        await CredentialSvc.DeleteAsync(id);
        await Reload();
    }
}
