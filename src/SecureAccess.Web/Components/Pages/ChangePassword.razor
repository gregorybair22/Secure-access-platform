@page "/change-password"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAuthService Auth
@inject ICurrentUserService Current
@inject IToastService Toast

<PageTitle>Change Password - Secure Access</PageTitle>

<div class="cp-page">
    <header class="cp-header">
        <div class="cp-header-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <rect x="9" y="11" width="6" height="5" rx="1" fill="currentColor" stroke="none" opacity="0.9"/>
            </svg>
        </div>
        <div>
            <h1>Change Password</h1>
            <p>Ensure your account is using a long, random password to stay secure.</p>
        </div>
    </header>

    <div class="cp-grid">
        <div class="cp-form-card">
            <h2>Password Details</h2>
            <p class="cp-form-sub">Update your password by filling in the fields below.</p>

            <div class="cp-field">
                <label for="current">Current Password</label>
                <div class="cp-input-wrap">
                    <span class="cp-input-icon" aria-hidden="true">@LockIcon</span>
                    <input id="current" class="cp-input" type="@(_showCurrent ? "text" : "password")" @bind="_current" placeholder="Enter your current password" autocomplete="current-password" />
                    <button type="button" class="cp-toggle" @onclick="() => _showCurrent = !_showCurrent" aria-label="@(_showCurrent ? "Hide" : "Show") password">
                        @EyeIcon(_showCurrent)
                    </button>
                </div>
            </div>

            <div class="cp-field">
                <label for="newpwd">New Password</label>
                <div class="cp-input-wrap">
                    <span class="cp-input-icon" aria-hidden="true">@LockIcon</span>
                    <input id="newpwd" class="cp-input" type="@(_showNew ? "text" : "password")" @bind="_new" @bind:event="oninput" placeholder="Enter your new password" autocomplete="new-password" />
                    <button type="button" class="cp-toggle" @onclick="() => _showNew = !_showNew" aria-label="@(_showNew ? "Hide" : "Show") password">
                        @EyeIcon(_showNew)
                    </button>
                </div>
                <div class="cp-strength">
                    <div class="cp-strength-bars">
                        @for (var i = 0; i < 5; i++)
                        {
                            <span class="cp-strength-bar @(i < StrengthScore ? "filled" : "")"></span>
                        }
                    </div>
                    <span class="cp-strength-label">Password strength: <strong>@StrengthLabel</strong></span>
                </div>
                <p class="cp-hint">Use at least 8 characters with a mix of letters, numbers &amp; symbols.</p>
            </div>

            <div class="cp-field">
                <label for="confirm">Confirm New Password</label>
                <div class="cp-input-wrap">
                    <span class="cp-input-icon" aria-hidden="true">@LockIcon</span>
                    <input id="confirm" class="cp-input" type="@(_showConfirm ? "text" : "password")" @bind="_confirm" placeholder="Confirm your new password" autocomplete="new-password" />
                    <button type="button" class="cp-toggle" @onclick="() => _showConfirm = !_showConfirm" aria-label="@(_showConfirm ? "Hide" : "Show") password">
                        @EyeIcon(_showConfirm)
                    </button>
                </div>
            </div>

            <button class="cp-submit" type="button" @onclick="Submit" disabled="@_busy">
                @LockIcon
                @(_busy ? "Updating..." : "Change Password")
            </button>
        </div>

        <aside class="cp-tips-card">
            <div class="cp-tips-head">
                @ShieldIcon
                <h3>Password Tips</h3>
            </div>
            <ul class="cp-tips-list">
                <li><span class="cp-check">✓</span> Use at least 8 characters</li>
                <li><span class="cp-check">✓</span> Include uppercase and lowercase letters</li>
                <li><span class="cp-check">✓</span> Add numbers and special characters</li>
                <li><span class="cp-check">✓</span> Avoid using personal or common words</li>
                <li><span class="cp-check">✓</span> Don't reuse old passwords</li>
            </ul>
            <p class="cp-tips-foot">
                @LockIcon
                A strong password helps keep your account and data secure.
            </p>
        </aside>
    </div>
</div>

@code {
    private string _current = "", _new = "", _confirm = "";
    private bool _busy;
    private bool _showCurrent, _showNew, _showConfirm;

    private int StrengthScore => CalcStrength(_new);

    private string StrengthLabel => StrengthScore switch
    {
        0 => "—",
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => "Very strong"
    };

    private static int CalcStrength(string? pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        var score = 0;
        if (pwd.Length >= 8) score++;
        if (pwd.Any(char.IsLower) && pwd.Any(char.IsUpper)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(c => !char.IsLetterOrDigit(c))) score++;
        if (pwd.Length >= 12) score++;
        return Math.Min(5, score);
    }

    private async Task Submit()
    {
        if (_new != _confirm) { await Toast.ErrorAsync("New passwords do not match."); return; }
        if (StrengthScore < 2) { await Toast.ErrorAsync("Please choose a stronger password (see tips)."); return; }
        if (Current.UserId is not { } userId) { await Toast.ErrorAsync("Not authenticated."); return; }

        _busy = true;
        try
        {
            var result = await Auth.ChangePasswordAsync(userId, new() { CurrentPassword = _current, NewPassword = _new });
            if (!result.Succeeded) { await Toast.ErrorAsync(result.Error ?? "Could not change password."); return; }
            await Toast.SuccessAsync("Password changed successfully.");
            _current = _new = _confirm = "";
        }
        finally
        {
            _busy = false;
        }
    }

    private static MarkupString LockIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>");

    private static MarkupString ShieldIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>");

    private static MarkupString EyeIcon(bool visible) => visible
        ? new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94\"/><path d=\"M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>")
        : new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>");
}
