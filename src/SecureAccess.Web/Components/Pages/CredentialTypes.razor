@page "/credential-types"
@attribute [Authorize(Policy = "perm:credentials.create")]
@rendermode InteractiveServer
@inject SecureAccess.Application.Features.Credentials.ICredentialTypeService Types

<PageTitle>Credential Types - Secure Access</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Credential Types</h1>
    <button class="btn btn-primary" @onclick="StartNew">New Type</button>
</div>
<p class="text-muted">Predefined and unlimited custom credential types. Mark fields as secret to encrypt them at rest.</p>

@if (_editing is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_editingId == 0 ? "New Type" : "Edit Type")</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
            <div class="row g-2 mb-2">
                <div class="col-md-5"><label class="form-label">Name *</label><input class="form-control" @bind="_editing.Name" /></div>
                <div class="col-md-5"><label class="form-label">Description</label><input class="form-control" @bind="_editing.Description" /></div>
                <div class="col-md-2 form-check mt-4 ms-2">
                    <input class="form-check-input" type="checkbox" @bind="_editing.IsActive" id="active" />
                    <label class="form-check-label" for="active">Active</label>
                </div>
            </div>

            <h6>Fields</h6>
            <table class="table table-sm">
                <thead><tr><th>Key</th><th>Label</th><th>Type</th><th>Secret</th><th>Required</th><th>Searchable</th><th></th></tr></thead>
                <tbody>
                    @foreach (var f in _editing.Fields)
                    {
                        <tr>
                            <td><input class="form-control form-control-sm" @bind="f.Key" /></td>
                            <td><input class="form-control form-control-sm" @bind="f.Label" /></td>
                            <td>
                                <select class="form-select form-select-sm" @bind="f.Type">
                                    @foreach (var ft in Enum.GetValues<CredentialFieldType>()) { <option value="@ft">@ft</option> }
                                </select>
                            </td>
                            <td><input type="checkbox" @bind="f.IsSecret" /></td>
                            <td><input type="checkbox" @bind="f.IsRequired" /></td>
                            <td><input type="checkbox" @bind="f.IsSearchable" /></td>
                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => _editing.Fields.Remove(f)">x</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn btn-sm btn-outline-secondary" @onclick="AddField">Add Field</button>

            <div class="mt-3">
                <button class="btn btn-success" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editing = null">Cancel</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Fields</th><th>System</th><th>Active</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in _items)
        {
            <tr>
                <td>@t.Name</td>
                <td>@string.Join(", ", t.Fields.Select(f => f.Label))</td>
                <td>@(t.IsSystem ? "Yes" : "No")</td>
                <td>@(t.IsActive ? "Yes" : "No")</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(t)">Edit</button>
                    @if (!t.IsSystem) { <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(t.Id)">Delete</button> }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<SecureAccess.Application.Features.Credentials.CredentialTypeDto> _items = new();
    private SecureAccess.Application.Features.Credentials.SaveCredentialTypeRequest? _editing;
    private int _editingId;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Reload();
    private async Task Reload() => _items = (await Types.GetTypesAsync(includeInactive: true)).ToList();

    private void StartNew()
    {
        _error = null; _editingId = 0;
        _editing = new() { IsActive = true, Fields = new() };
    }

    private void Edit(SecureAccess.Application.Features.Credentials.CredentialTypeDto t)
    {
        _error = null; _editingId = t.Id;
        _editing = new()
        {
            Name = t.Name, Description = t.Description, Icon = t.Icon, IsActive = t.IsActive,
            Fields = t.Fields.Select(f => new SecureAccess.Application.Features.Credentials.CredentialFieldDto
            {
                Key = f.Key, Label = f.Label, Type = f.Type, IsSecret = f.IsSecret,
                IsRequired = f.IsRequired, IsSearchable = f.IsSearchable, Order = f.Order
            }).ToList()
        };
    }

    private void AddField()
        => _editing!.Fields.Add(new() { Order = _editing.Fields.Count + 1, Type = CredentialFieldType.Text });

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editing!.Name)) { _error = "Name is required."; return; }
        for (var i = 0; i < _editing.Fields.Count; i++) _editing.Fields[i].Order = i + 1;
        var result = _editingId == 0 ? (Result)await Types.CreateAsync(_editing) : await Types.UpdateAsync(_editingId, _editing);
        if (!result.Succeeded) { _error = result.Error; return; }
        _editing = null;
        await Reload();
    }

    private async Task Delete(int id)
    {
        var r = await Types.DeleteAsync(id);
        if (!r.Succeeded) { _error = r.Error; }
        await Reload();
    }
}
