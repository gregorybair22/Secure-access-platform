@page "/credential-types"
@attribute [Authorize(Policy = "perm:credentials.create")]
@rendermode InteractiveServer
@using SecureAccess.Application.Features.Credentials
@using SecureAccess.Application.Common
@inject ICredentialTypeService Types

<PageTitle>Credential Types - Secure Access</PageTitle>

<div class="credtypes-page">
    @if (!string.IsNullOrEmpty(_error) && _editing is null && _deleteTarget is null)
    {
        <div class="credtypes-page-alert" role="alert">@_error</div>
    }

    <header class="credtypes-page-header">
        <div class="credtypes-page-title-block">
            <div class="credtypes-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                </svg>
            </div>
            <div>
                <h1>Credential Types</h1>
                <p class="credtypes-page-subtitle">Predefined and unlimited custom credential types. Mark fields as secret to encrypt them at rest.</p>
            </div>
        </div>
        <button type="button" class="credtypes-btn-primary" @onclick="StartNew">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            New Type
        </button>
    </header>

    <div class="credtypes-stats">
        <article class="credtypes-stat-card">
            <div class="credtypes-stat-icon credtypes-stat-icon-total" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                </svg>
            </div>
            <div>
                <p class="credtypes-stat-label">Total Types</p>
                <p class="credtypes-stat-value">@_stats.TotalTypes</p>
                <p class="credtypes-stat-hint">All credential types</p>
            </div>
        </article>
        <article class="credtypes-stat-card">
            <div class="credtypes-stat-icon credtypes-stat-icon-system" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div>
                <p class="credtypes-stat-label">System Types</p>
                <p class="credtypes-stat-value">@_stats.SystemTypes</p>
                <p class="credtypes-stat-hint">Built-in by system</p>
            </div>
        </article>
        <article class="credtypes-stat-card">
            <div class="credtypes-stat-icon credtypes-stat-icon-active" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
            </div>
            <div>
                <p class="credtypes-stat-label">Active Types</p>
                <p class="credtypes-stat-value">@_stats.ActiveTypes</p>
                <p class="credtypes-stat-hint">Currently active</p>
            </div>
        </article>
        <article class="credtypes-stat-card">
            <div class="credtypes-stat-icon credtypes-stat-icon-custom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                </svg>
            </div>
            <div>
                <p class="credtypes-stat-label">Custom Types</p>
                <p class="credtypes-stat-value">@_stats.CustomTypes</p>
                <p class="credtypes-stat-hint">Created by users</p>
            </div>
        </article>
    </div>

    <div class="credtypes-card">
        <div class="credtypes-toolbar">
            <div class="credtypes-toolbar-search">
                <svg class="credtypes-toolbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="search" placeholder="Search by name..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <select @bind="_activeFilter" @bind:after="ResetPage" aria-label="Filter by status">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <select @bind="_systemFilter" @bind:after="ResetPage" aria-label="Filter by system">
                <option value="">All Types</option>
                <option value="system">System</option>
                <option value="custom">Custom</option>
            </select>
            <button type="button" class="credtypes-btn-outline" title="Filters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Filter
            </button>
        </div>

        @if (PagedItems.Count == 0)
        {
            <div class="credtypes-empty-state">
                <div class="credtypes-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                        <line x1="7" y1="7" x2="7.01" y2="7"/>
                    </svg>
                </div>
                <h2>No credential types found</h2>
                <p>Get started by adding your first credential type.</p>
                <button type="button" class="credtypes-btn-primary" @onclick="StartNew">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    New Type
                </button>
            </div>
        }
        else
        {
            <div class="credtypes-table-wrap">
                <table class="credtypes-table">
                    <thead>
                        <tr>
                            <th class="text-center"><button type="button" class="credtypes-th-sort @SortClass("name")" @onclick='() => SortBy("name")'>Name @SortIcon</button></th>
                            <th class="text-center">Fields</th>
                            <th class="text-center"><button type="button" class="credtypes-th-sort @SortClass("system")" @onclick='() => SortBy("system")'>System @SortIcon</button></th>
                            <th class="text-center"><button type="button" class="credtypes-th-sort @SortClass("active")" @onclick='() => SortBy("active")'>Active @SortIcon</button></th>
                            <th class="text-center credtypes-th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in PagedItems)
                        {
                            <tr>
                                <td>
                                    <div class="credtypes-name-cell">
                                        <span class="credtypes-type-icon @TypeIconClass(t)" aria-hidden="true">@TypeIconSymbol(t)</span>
                                        <span class="credtypes-type-name">@t.Name</span>
                                    </div>
                                </td>
                                <td class="text-center credtypes-fields-cell">@FormatFields(t)</td>
                                <td class="text-center">
                                    <span class="credtypes-yesno-badge @(t.IsSystem ? "credtypes-yesno-yes" : "credtypes-yesno-no")">
                                        @(t.IsSystem ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="credtypes-yesno-badge @(t.IsActive ? "credtypes-yesno-yes" : "credtypes-yesno-no")">
                                        @(t.IsActive ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="credtypes-actions">
                                        <button type="button" class="credtypes-btn-edit" @onclick="() => Edit(t)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Edit
                                        </button>
                                        @if (!t.IsSystem)
                                        {
                                            <button type="button" class="credtypes-btn-delete" @onclick="() => OpenDeleteConfirm(t)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                                </svg>
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="credtypes-footer">
            <span>Showing @RangeStart to @RangeEnd of @FilteredCount entries</span>
            <div class="credtypes-footer-right">
                <label class="credtypes-page-size">
                    Rows per page:
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </label>
                <div class="credtypes-pagination">
                    <button type="button" disabled="@(_page <= 1)" @onclick="FirstPage" aria-label="First page">«</button>
                    <button type="button" disabled="@(_page <= 1)" @onclick="PrevPage" aria-label="Previous page">‹</button>
                    @for (var p = 1; p <= TotalPages; p++)
                    {
                        var pageNum = p;
                        <button type="button" class="@(_page == pageNum ? "active" : null)" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="NextPage" aria-label="Next page">›</button>
                    <button type="button" disabled="@(_page >= TotalPages)" @onclick="LastPage" aria-label="Last page">»</button>
                </div>
            </div>
        </footer>
    </div>
</div>

@if (_deleteTarget is not null)
{
    <div class="sa-modal-backdrop credtypes-modal-backdrop @(_deleteModalClosing ? "is-closing" : null)" @onclick="CloseDeleteModalAsync">
        <div class="sa-modal-panel credtypes-modal credtypes-modal-confirm" role="alertdialog" aria-modal="true" aria-labelledby="credtypes-delete-title" @onclick:stopPropagation="true">
            <div class="credtypes-modal-header credtypes-modal-header-danger">
                <div class="credtypes-delete-header-main">
                    <div class="credtypes-delete-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <div>
                        <h2 id="credtypes-delete-title">Delete credential type</h2>
                        <p class="credtypes-modal-subtitle">This action cannot be undone.</p>
                    </div>
                </div>
                <button type="button" class="credtypes-modal-close" aria-label="Close" @onclick="CloseDeleteModalAsync">×</button>
            </div>
            <div class="credtypes-modal-body">
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="credtypes-modal-alert" role="alert">@_deleteError</div>
                }
                <p class="credtypes-delete-message">
                    Are you sure you want to delete <strong>@_deleteTarget.Name</strong>?
                </p>
            </div>
            <div class="credtypes-modal-footer">
                <button type="button" class="credtypes-btn-secondary" @onclick="CloseDeleteModalAsync">Cancel</button>
                <button type="button" class="credtypes-btn-danger" @onclick="ConfirmDeleteAsync">Delete type</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="sa-modal-backdrop credtypes-modal-backdrop @(_editModalClosing ? "is-closing" : null)" @onclick="CloseEditModalAsync">
        <div class="sa-modal-panel credtypes-modal credtypes-modal-wide" role="dialog" aria-modal="true" aria-labelledby="credtypes-modal-title" @onclick:stopPropagation="true">
            <div class="credtypes-modal-header">
                <h2 id="credtypes-modal-title">@(_editingId == 0 ? "New Credential Type" : "Edit Credential Type")</h2>
                <button type="button" class="credtypes-modal-close" aria-label="Close" @onclick="CloseEditModalAsync">×</button>
            </div>
            <div class="credtypes-modal-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="credtypes-modal-alert" role="alert">@_error</div>
                }
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Name *</label>
                        <input class="form-control" @bind="_editing.Name" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Description</label>
                        <input class="form-control" @bind="_editing.Description" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" @bind="_editing.IsActive" id="credtype-active" />
                            <label class="form-check-label" for="credtype-active">Active</label>
                        </div>
                    </div>
                </div>

                <h3 class="credtypes-fields-heading">Fields</h3>
                <div class="credtypes-fields-table-wrap">
                    <table class="credtypes-fields-table">
                        <thead>
                            <tr>
                                <th>Key</th>
                                <th>Label</th>
                                <th>Type</th>
                                <th class="text-center">Secret</th>
                                <th class="text-center">Required</th>
                                <th class="text-center">Searchable</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _editing.Fields)
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" @bind="f.Key" /></td>
                                    <td><input class="form-control form-control-sm" @bind="f.Label" /></td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="f.Type">
                                            @foreach (var ft in Enum.GetValues<CredentialFieldType>())
                                            {
                                                <option value="@ft">@ft</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center"><input type="checkbox" @bind="f.IsSecret" /></td>
                                    <td class="text-center"><input type="checkbox" @bind="f.IsRequired" /></td>
                                    <td class="text-center"><input type="checkbox" @bind="f.IsSearchable" /></td>
                                    <td>
                                        <button type="button" class="credtypes-field-remove" @onclick="() => _editing.Fields.Remove(f)" aria-label="Remove field">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" class="credtypes-btn-outline credtypes-add-field" @onclick="AddField">+ Add Field</button>
            </div>
            <div class="credtypes-modal-footer">
                @if (_editingId != 0 && _deleteTarget is null && !IsEditingSystem)
                {
                    <button type="button" class="credtypes-btn-danger credtypes-modal-delete" @onclick="OpenDeleteFromEditAsync">Delete</button>
                }
                <div class="credtypes-modal-footer-actions">
                    <button type="button" class="credtypes-btn-secondary" @onclick="CloseEditModalAsync">Cancel</button>
                    <button type="button" class="credtypes-btn-primary" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CredentialTypeDto> _items = new();
    private CredentialTypeListStats _stats = new();

    private SaveCredentialTypeRequest? _editing;
    private bool _editModalClosing;
    private bool _deleteModalClosing;
    private int _editingId;
    private string? _error;
    private CredentialTypeDto? _deleteTarget;
    private string? _deleteError;

    private string _search = "";
    private string _activeFilter = "";
    private string _systemFilter = "";
    private string _sortColumn = "name";
    private bool _sortAsc = true;
    private int _page = 1;
    private int _pageSize = 10;

    private bool IsEditingSystem => _editingId != 0 && _items.FirstOrDefault(t => t.Id == _editingId)?.IsSystem == true;

    private MarkupString SortIcon => new(
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">" +
        "<path d=\"m7 15 5 5 5-5\"/><path d=\"m7 9 5-4 5 4\"/></svg>");

    private IEnumerable<CredentialTypeDto> FilteredItems
    {
        get
        {
            IEnumerable<CredentialTypeDto> q = _items;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                q = q.Where(t =>
                    t.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (t.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            q = _activeFilter switch
            {
                "active" => q.Where(t => t.IsActive),
                "inactive" => q.Where(t => !t.IsActive),
                _ => q
            };

            q = _systemFilter switch
            {
                "system" => q.Where(t => t.IsSystem),
                "custom" => q.Where(t => !t.IsSystem),
                _ => q
            };

            q = _sortColumn switch
            {
                "system" => _sortAsc ? q.OrderBy(t => t.IsSystem) : q.OrderByDescending(t => t.IsSystem),
                "active" => _sortAsc ? q.OrderBy(t => t.IsActive) : q.OrderByDescending(t => t.IsActive),
                _ => _sortAsc ? q.OrderBy(t => t.Name) : q.OrderByDescending(t => t.Name)
            };

            return q;
        }
    }

    private int FilteredCount => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));
    private List<CredentialTypeDto> PagedItems =>
        FilteredItems.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    private int RangeStart => FilteredCount == 0 ? 0 : (_page - 1) * _pageSize + 1;
    private int RangeEnd => Math.Min(_page * _pageSize, FilteredCount);

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _items = (await Types.GetTypesAsync(includeInactive: true)).ToList();
        _stats = await Types.GetListStatsAsync();
        _error = null;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void StartNew()
    {
        _error = null;
        _editingId = 0;
        _editing = new SaveCredentialTypeRequest { IsActive = true, Fields = new() };
    }

    private void Edit(CredentialTypeDto t)
    {
        _error = null;
        _editingId = t.Id;
        _editing = new SaveCredentialTypeRequest
        {
            Name = t.Name,
            Description = t.Description,
            Icon = t.Icon,
            IsActive = t.IsActive,
            Fields = t.Fields.Select(f => new CredentialFieldDto
            {
                Key = f.Key,
                Label = f.Label,
                Type = f.Type,
                IsSecret = f.IsSecret,
                IsRequired = f.IsRequired,
                IsSearchable = f.IsSearchable,
                Order = f.Order
            }).ToList()
        };
    }

    private void OpenDeleteConfirm(CredentialTypeDto t)
    {
        _deleteTarget = t;
        _deleteError = null;
    }

    private Task CloseEditModalAsync()
    {
        if (_editing is null || _editModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _editModalClosing,
            v => _editModalClosing = v,
            () => _editing = null,
            StateHasChanged);
    }

    private async Task OpenDeleteFromEditAsync()
    {
        if (_editingId == 0 || IsEditingSystem) return;
        var target = _items.FirstOrDefault(t => t.Id == _editingId);
        if (target is null) return;
        await CloseEditModalAsync();
        _deleteTarget = target;
        _deleteError = null;
    }

    private Task CloseDeleteModalAsync()
    {
        if (_deleteTarget is null || _deleteModalClosing) return Task.CompletedTask;
        return ModalAnimation.CloseAsync(
            () => _deleteModalClosing,
            v => _deleteModalClosing = v,
            () => _deleteTarget = null,
            StateHasChanged);
    }

    private void AddField()
        => _editing!.Fields.Add(new CredentialFieldDto { Order = _editing.Fields.Count + 1, Type = CredentialFieldType.Text });

    private void SortBy(string column)
    {
        if (_sortColumn == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = column;
            _sortAsc = true;
        }
        _page = 1;
    }

    private string SortClass(string column) => _sortColumn == column ? "active" : "";

    private static string FormatFields(CredentialTypeDto t)
    {
        var labels = t.Fields.OrderBy(f => f.Order).Select(f => f.Label).Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
        return labels.Count == 0 ? "—" : string.Join(", ", labels);
    }

    private static string TypeIconClass(CredentialTypeDto t) => t.Icon switch
    {
        "desktop" => "credtypes-type-icon-desktop",
        "remote" => "credtypes-type-icon-remote",
        "vpn" => "credtypes-type-icon-vpn",
        "key" => "credtypes-type-icon-key",
        _ => "credtypes-type-icon-default"
    };

    private static string TypeIconSymbol(CredentialTypeDto t) => t.Icon switch
    {
        "desktop" => "◆",
        "remote" => "▣",
        "vpn" => "◎",
        "key" => "⬡",
        _ => "◇"
    };

    private void ResetPage() => _page = 1;

    private void OnPageSizeChanged()
    {
        _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void FirstPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void LastPage() => _page = TotalPages;
    private void GoToPage(int p) => _page = p;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;

        _deleteError = null;
        var result = await Types.DeleteAsync(_deleteTarget.Id);
        if (!result.Succeeded)
        {
            _deleteError = result.Error;
            return;
        }

        if (_editingId == _deleteTarget.Id)
            _editing = null;

        await CloseDeleteModalAsync();
        await Reload();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editing!.Name))
        {
            _error = "Name is required.";
            return;
        }

        for (var i = 0; i < _editing.Fields.Count; i++)
            _editing.Fields[i].Order = i + 1;

        Result result;
        if (_editingId == 0)
            result = await Types.CreateAsync(_editing);
        else
            result = await Types.UpdateAsync(_editingId, _editing);

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        await CloseEditModalAsync();
        await Reload();
    }
}
