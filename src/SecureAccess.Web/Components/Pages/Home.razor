@page "/"
@attribute [Authorize(Policy = "perm:dashboard.view")]
@rendermode InteractiveServer

<PageTitle>Dashboard - Secure Access</PageTitle>

<div class="dash-page">
    <header class="dash-page-header">
        <div class="dash-page-title-block">
            <div class="dash-page-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="9"/>
                    <rect x="14" y="3" width="7" height="5"/>
                    <rect x="14" y="12" width="7" height="9"/>
                    <rect x="3" y="16" width="7" height="5"/>
                </svg>
            </div>
            <div>
                <h1>Dashboard</h1>
                <p class="dash-page-subtitle">Overview of your credential management system.</p>
            </div>
        </div>
        <div class="dash-date-range">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <input type="date" class="dash-date-input" @bind="_rangeFrom" @bind:after="ReloadAsync" aria-label="From date" />
            <span class="dash-date-sep">–</span>
            <input type="date" class="dash-date-input" @bind="_rangeTo" @bind:after="ReloadAsync" aria-label="To date" />
        </div>
    </header>

    @if (_loading)
    {
        <p class="dash-loading" role="status">Loading dashboard…</p>
    }
    else if (_data is not null)
    {
        <div class="dash-stats-grid">
            @foreach (var card in StatCards)
            {
                <article class="dash-stat-card @(card.Warn ? "dash-stat-warn" : null)">
                    <div class="dash-stat-icon dash-stat-icon-@card.Tone" aria-hidden="true">
                        @StatIcon(card.Tone)
                    </div>
                    <p class="dash-stat-label">@card.Label</p>
                    <p class="dash-stat-value">@card.Value</p>
                    <p class="dash-stat-delta @DeltaClass(card.Delta)">@card.Delta.Text</p>
                </article>
            }
        </div>

        <div class="dash-panels-row">
            @foreach (var panel in RankingCards)
            {
                <article class="dash-card dash-rank-card">
                    <h3 class="dash-rank-title">@panel.Title</h3>
                    @if (panel.Items.Count == 0)
                    {
                        <div class="dash-empty">
                            <div class="dash-empty-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                                </svg>
                            </div>
                            <p class="dash-empty-title">No data available</p>
                            <p class="dash-empty-text">@panel.EmptyMessage</p>
                        </div>
                    }
                    else
                    {
                        <ul class="dash-rank-list">
                            @foreach (var row in panel.Items)
                            {
                                <li>
                                    <span class="dash-rank-name">@row.Name</span>
                                    <span class="dash-rank-count">@row.Count</span>
                                </li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>

        <div class="dash-bottom-row">
            <article class="dash-card dash-security-card">
                <div class="dash-card-head">
                    <div class="dash-card-head-icon dash-card-head-icon-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <h2>Security &amp; Audit Overview</h2>
                </div>
                <div class="dash-security-metrics">
                    @{
                        var unauth = Compare(_data.UnauthorizedAccessAttempts, _data.UnauthorizedAccessAttemptsPrevious30, "vs previous period", upIsGood: false);
                        var ooh = Compare(_data.AccessesOutsideWorkingHours, _data.AccessesOutsideWorkingHoursPrevious30, "vs previous period", upIsGood: false);
                        var viewed = Compare(_data.CredentialsViewedInRange, _data.CredentialsViewedPreviousRange, "vs previous period");
                    }
                    <div class="dash-security-metric">
                        <div class="dash-security-metric-icon dash-tone-red" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        </div>
                        <p class="dash-security-label">Unauthorized Attempts</p>
                        <p class="dash-security-value">@_data.UnauthorizedAccessAttempts</p>
                        <p class="dash-security-delta @DeltaClass(unauth)">@unauth.Text</p>
                    </div>
                    <div class="dash-security-metric">
                        <div class="dash-security-metric-icon dash-tone-orange" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <p class="dash-security-label">Out-of-Hours Accesses</p>
                        <p class="dash-security-value">@_data.AccessesOutsideWorkingHours</p>
                        <p class="dash-security-delta @DeltaClass(ooh)">@ooh.Text</p>
                    </div>
                    <div class="dash-security-metric">
                        <div class="dash-security-metric-icon dash-tone-blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </div>
                        <p class="dash-security-label">Credentials Viewed</p>
                        <p class="dash-security-value">@_data.CredentialsViewedInRange</p>
                        <p class="dash-security-delta @DeltaClass(viewed)">@viewed.Text</p>
                    </div>
                    <div class="dash-security-metric">
                        <div class="dash-security-metric-icon dash-tone-purple" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                        </div>
                        <p class="dash-security-label">Last Bulk Update</p>
                        <p class="dash-security-value dash-security-value-sm">@FormatBulkUpdate(_data.LastBulkUpdateUtc)</p>
                        <p class="dash-security-delta muted">@(_data.LastBulkUpdateUtc.HasValue ? _data.LastBulkUpdateUtc.Value.ToLocalTime().ToString("g") : "No bulk updates")</p>
                    </div>
                </div>
            </article>

            <article class="dash-card dash-activity-card">
                <div class="dash-card-head dash-card-head-row">
                    <div class="dash-card-head-left">
                        <div class="dash-card-head-icon dash-card-head-icon-list" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="8" y1="6" x2="21" y2="6"/>
                                <line x1="8" y1="12" x2="21" y2="12"/>
                                <line x1="8" y1="18" x2="21" y2="18"/>
                                <line x1="3" y1="6" x2="3.01" y2="6"/>
                                <line x1="3" y1="12" x2="3.01" y2="12"/>
                                <line x1="3" y1="18" x2="3.01" y2="18"/>
                            </svg>
                        </div>
                        <h2>Recent Activity</h2>
                    </div>
                    <a href="/audit" class="dash-view-all">View all</a>
                </div>
                <div class="dash-activity-list">
                    @if (_data.RecentActivity.Count == 0)
                    {
                        <div class="dash-activity-empty">
                            <span class="dash-activity-dot dash-tone-blue" aria-hidden="true"></span>
                            <div>
                                <p class="dash-activity-title">No recent activity</p>
                                <p class="dash-activity-time">There is no recent activity to display.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in _data.RecentActivity)
                        {
                            <div class="dash-activity-item">
                                <span class="dash-activity-dot dash-tone-@item.Tone" aria-hidden="true"></span>
                                <div>
                                    <p class="dash-activity-title">@item.Title</p>
                                    <p class="dash-activity-time">@item.Subtitle</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </article>
        </div>
    }
</div>
